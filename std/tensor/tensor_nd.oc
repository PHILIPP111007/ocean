import <std/tensor/tensor.oc>
cimport <std/tensor/autograd_runtime.h>

def reshape3(input: &Tensor[float32], dim0: int, dim1: int, dim2: int) -> Tensor[float32]:
    var input_handle: ocean_tensor_handle_t = input.raw_handle()
    var handle: ocean_tensor_handle_t = ocean_autograd_reshape_3d(input_handle, dim0, dim1, dim2)
    var result: Tensor[float32] = Tensor(handle)
    return result

def reshape4(input: &Tensor[float32], dim0: int, dim1: int, dim2: int, dim3: int) -> Tensor[float32]:
    var input_handle: ocean_tensor_handle_t = input.raw_handle()
    var handle: ocean_tensor_handle_t = ocean_autograd_reshape_4d(input_handle, dim0, dim1, dim2, dim3)
    var result: Tensor[float32] = Tensor(handle)
    return result

def transpose_dims(input: &Tensor[float32], dim0: int, dim1: int) -> Tensor[float32]:
    var input_handle: ocean_tensor_handle_t = input.raw_handle()
    var handle: ocean_tensor_handle_t = ocean_autograd_transpose_dims(input_handle, dim0, dim1)
    var result: Tensor[float32] = Tensor(handle)
    return result

def sum_dim(input: &Tensor[float32], dim: int, keepdim: bool) -> Tensor[float32]:
    var input_handle: ocean_tensor_handle_t = input.raw_handle()
    var handle: ocean_tensor_handle_t = ocean_autograd_sum_dim(input_handle, dim, keepdim)
    var result: Tensor[float32] = Tensor(handle)
    return result

def mean_dim(input: &Tensor[float32], dim: int, keepdim: bool) -> Tensor[float32]:
    var input_handle: ocean_tensor_handle_t = input.raw_handle()
    var handle: ocean_tensor_handle_t = ocean_autograd_mean_dim(input_handle, dim, keepdim)
    var result: Tensor[float32] = Tensor(handle)
    return result
