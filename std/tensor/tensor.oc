cimport <std/tensor/tensor_runtime.h>
cimport <std/tensor/autograd_runtime.h>
cimport <math.h>


# Public device-aware Tensor facade.  The C handle is intentionally opaque;
# users manipulate Tensor values and never see CPU pointers or cl_mem.
class Tensor:
    def __init__(self, handle: ocean_tensor_handle_t):
        self.handle = handle

    def raw_handle(self) -> ocean_tensor_handle_t:
        return self.handle

    def requires_grad_(self, value: bool) -> None:
        ocean_autograd_set_requires_grad(self.handle, value)
        return None

    def requires_grad(self) -> bool:
        return ocean_autograd_requires_grad(self.handle)

    def has_grad(self) -> bool:
        return ocean_autograd_has_grad(self.handle)

    def grad(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_grad_copy(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def zero_grad(self) -> None:
        ocean_autograd_zero_grad(self.handle)
        return None

    def backward(self) -> None:
        ocean_autograd_backward(self.handle)
        return None

    @staticmethod
    def set_grad_enabled(enabled: bool) -> None:
        ocean_autograd_set_grad_enabled(enabled)
        return None

    @staticmethod
    def grad_enabled() -> bool:
        return ocean_autograd_grad_enabled()

    def relu(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_relu(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def gelu(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_gelu(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    @staticmethod
    def empty(rows: int, cols: int, device: str) -> Tensor:
        # Compiler intrinsic replaces this fallback and preserves arbitrary
        # rank/dtype from the annotated Tensor[T] call.
        return Tensor.zeros(rows, cols, device)

    @staticmethod
    def zeros(rows: int, cols: int, device: str) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_zeros(rows, cols, device)
        var value: Tensor = Tensor(handle)
        return value

    @staticmethod
    def from_list(source: pointer, device: str) -> Tensor:
        # Compiler intrinsic. The backend lowers every valid call directly,
        # preserving the annotated element dtype and rectangular shape.
        # This fallback is unreachable for valid calls: the compiler lowers
        # Tensor.from_list(...) before the class method is emitted.
        return Tensor.zeros(1, 1, device)

    @staticmethod
    def load_npy(path: str, device: str) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_load_npy(path, device)
        var value: Tensor = Tensor(handle)
        return value

    def save_npy(self, path: str) -> None:
        ocean_tensor_save_npy(self.handle, path)
        return None

    def to(self, device: str) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_to(self.handle, device)
        var value: Tensor = Tensor(handle)
        return value

    def copy(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_copy(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def copy_into(self, source: &Tensor) -> None:
        ocean_tensor_copy_into(self.handle, source.handle)
        return None

    def cache_write(self, value: &Tensor, position: int) -> None:
        ocean_tensor_cache_write(self.handle, value.handle, position)
        return None

    def argmax(self) -> int:
        return ocean_tensor_argmax(self.handle)

    def ternary_quantize(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_ternary_quantize(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def ternary_scale(self) -> float64:
        return ocean_tensor_ternary_scale(self.handle)

    def ternary_pack(self, scale: float64, transpose: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_ternary_pack(self.handle, scale, transpose)
        var value: Tensor = Tensor(handle)
        return value

    def matmul(self, other: &Tensor) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_matmul(self.handle, other.handle)
        var value: Tensor = Tensor(handle)
        return value

    def linear_inference(self, weight: &Tensor, bias: &Tensor) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_linear_inference(self.handle, weight.handle, bias.handle)
        var value: Tensor = Tensor(handle)
        return value

    def packed_matmul_inference(self, packed_weight: &Tensor, scale: float64, out_features: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_packed_matmul_inference(self.handle, packed_weight.handle, scale, out_features)
        var value: Tensor = Tensor(handle)
        return value

    def packed_linear_inference(self, packed_weight: &Tensor, scale: float64, bias: &Tensor, out_features: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_packed_linear_inference(self.handle, packed_weight.handle, scale, bias.handle, out_features)
        var value: Tensor = Tensor(handle)
        return value

    def packed_qkv_inference(self, q_weight: &Tensor, q_scale: float64, q_bias: &Tensor, k_weight: &Tensor, k_scale: float64, k_bias: &Tensor, v_weight: &Tensor, v_scale: float64, v_bias: &Tensor, out_features: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_packed_qkv_inference(self.handle, q_weight.handle, q_scale, q_bias.handle, k_weight.handle, k_scale, k_bias.handle, v_weight.handle, v_scale, v_bias.handle, out_features)
        var value: Tensor = Tensor(handle)
        return value

    def packed_qkv_inference_into(self, q_weight: &Tensor, q_scale: float64, q_bias: &Tensor, k_weight: &Tensor, k_scale: float64, k_bias: &Tensor, v_weight: &Tensor, v_scale: float64, v_bias: &Tensor, q_output: &Tensor, k_output: &Tensor, v_output: &Tensor, out_features: int) -> None:
        ocean_tensor_packed_qkv_inference_into(self.handle, q_weight.handle, q_scale, q_bias.handle, k_weight.handle, k_scale, k_bias.handle, v_weight.handle, v_scale, v_bias.handle, q_output.handle, k_output.handle, v_output.handle, out_features)
        return None

    def packed_qkv_attention_decode(self, q_weight: &Tensor, q_scale: float64, q_bias: &Tensor, k_weight: &Tensor, k_scale: float64, k_bias: &Tensor, v_weight: &Tensor, v_scale: float64, v_bias: &Tensor, cache_k: &Tensor, cache_v: &Tensor, position: int, n_heads: int, head_dim: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_packed_qkv_attention_decode(self.handle, q_weight.handle, q_scale, q_bias.handle, k_weight.handle, k_scale, k_bias.handle, v_weight.handle, v_scale, v_bias.handle, cache_k.handle, cache_v.handle, position, n_heads, head_dim)
        var value: Tensor = Tensor(handle)
        return value

    def add(self, other: &Tensor) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_binary(self.handle, other.handle, 0)
        var value: Tensor = Tensor(handle)
        return value

    def sub(self, other: &Tensor) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_binary(self.handle, other.handle, 1)
        var value: Tensor = Tensor(handle)
        return value

    def mul(self, other: &Tensor) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_binary(self.handle, other.handle, 2)
        var value: Tensor = Tensor(handle)
        return value

    def div(self, other: &Tensor) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_binary(self.handle, other.handle, 3)
        var value: Tensor = Tensor(handle)
        return value

    def add_scalar(self, value: float64) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_scalar(self.handle, value, 0)
        var result: Tensor = Tensor(handle)
        return result

    def sub_scalar(self, value: float64) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_scalar(self.handle, value, 1)
        var result: Tensor = Tensor(handle)
        return result

    def mul_scalar(self, value: float64) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_scalar(self.handle, value, 2)
        var result: Tensor = Tensor(handle)
        return result

    def div_scalar(self, value: float64) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_scalar(self.handle, value, 3)
        var result: Tensor = Tensor(handle)
        return result

    def reshape(self, rows: int, cols: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_reshape_2d(self.handle, rows, cols)
        var value: Tensor = Tensor(handle)
        return value

    def transpose(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_transpose(self.handle)
        var value: Tensor = Tensor(handle)
        return value


    def transpose_dims(self, dim0: int, dim1: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_transpose_dims(self.handle, dim0, dim1)
        var value: Tensor = Tensor(handle)
        return value

    def permute(self, axes: pointer) -> Tensor:
        # Compiler intrinsic. The backend lowers the axis list directly to
        # ocean_autograd_permute(). This fallback keeps the facade complete.
        var value: Tensor = self.copy()
        return value

    def sum_dim(self, dim: int, keepdim: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_sum_dim(self.handle, dim, keepdim)
        var value: Tensor = Tensor(handle)
        return value

    def mean_dim(self, dim: int, keepdim: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_mean_dim(self.handle, dim, keepdim)
        var value: Tensor = Tensor(handle)
        return value


    def exp(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_exp(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def log(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_log(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def sqrt(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_sqrt(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def pow(self, exponent: float64) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_pow(self.handle, exponent)
        var value: Tensor = Tensor(handle)
        return value

    def softmax(self, dim: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_softmax(self.handle, dim)
        var value: Tensor = Tensor(handle)
        return value

    def causal_softmax(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_causal_softmax(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def layer_norm(self, dim: int, epsilon: float64) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_autograd_layer_norm(self.handle, dim, epsilon)
        var value: Tensor = Tensor(handle)
        return value

    def layer_norm_affine(self, gamma: &Tensor, beta: &Tensor, dim: int, epsilon: float64) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_layer_norm_affine(self.handle, gamma.handle, beta.handle, dim, epsilon)
        var value: Tensor = Tensor(handle)
        return value

    def sparse_attention(self, key: &Tensor, value: &Tensor, top_k: int, scale: float64, query_start: int, causal: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention(self.handle, key.handle, value.handle, top_k, scale, query_start, causal)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_blocked(self, key: &Tensor, value: &Tensor, top_k: int, top_blocks: int, block_size: int, scale: float64, query_start: int, causal: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_blocked(self.handle, key.handle, value.handle, top_k, top_blocks, block_size, scale, query_start, causal)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_build_summaries(self, block_size: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_build_summaries(self.handle, block_size)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_build_summaries_active(self, active_length: int, block_size: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_build_summaries_active(self.handle, active_length, block_size)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_update_summary(self, key: &Tensor, position: int, block_size: int) -> None:
        ocean_tensor_sparse_attention_update_summary(self.handle, key.handle, position, block_size)
        return None

    def sparse_attention_update_summary_active(self, key: &Tensor, active_length: int, position: int, block_size: int) -> None:
        ocean_tensor_sparse_attention_update_summary_active(self.handle, key.handle, active_length, position, block_size)
        return None

    def sparse_attention_build_hierarchy(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_build_hierarchy(self.handle)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_build_hierarchy_active(self, active_length: int, block_size: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_build_hierarchy_active(self.handle, active_length, block_size)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_update_hierarchy_active(self, summaries: &Tensor, active_length: int, position: int, block_size: int) -> None:
        ocean_tensor_sparse_attention_update_hierarchy_active(self.handle, summaries.handle, active_length, position, block_size)
        return None

    def sparse_attention_build_route_active(self, summaries: &Tensor, active_length: int, summary_window: int, semantic_blocks: int, local_blocks: int, block_size: int, random_seed: int) -> Tensor[int32]:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_build_route_active(self.handle, summaries.handle, active_length, summary_window, semantic_blocks, local_blocks, block_size, random_seed)
        var result: Tensor[int32] = Tensor(handle)
        return result

    def sparse_attention_build_route_hierarchical_active(self, hierarchy: &Tensor, active_length: int, summary_window: int, semantic_blocks: int, local_blocks: int, block_size: int, random_seed: int) -> Tensor[int32]:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_build_route_hierarchical_active(self.handle, hierarchy.handle, active_length, summary_window, semantic_blocks, local_blocks, block_size, random_seed)
        var result: Tensor[int32] = Tensor(handle)
        return result

    def sparse_attention_update_route_active(self, summaries: &Tensor, route: Tensor[int32], active_length: int, summary_window: int, semantic_blocks: int, local_blocks: int, block_size: int, random_seed: int) -> None:
        ocean_tensor_sparse_attention_update_route_active(route.handle, self.handle, summaries.handle, active_length, summary_window, semantic_blocks, local_blocks, block_size, random_seed)
        return None

    def sparse_attention_update_route_hierarchical_active(self, hierarchy: &Tensor, route: Tensor[int32], active_length: int, summary_window: int, semantic_blocks: int, local_blocks: int, block_size: int, random_seed: int) -> None:
        ocean_tensor_sparse_attention_update_route_hierarchical_active(route.handle, self.handle, hierarchy.handle, active_length, summary_window, semantic_blocks, local_blocks, block_size, random_seed)
        return None

    def sparse_attention_blocked_cached(self, key: &Tensor, value: &Tensor, summaries: &Tensor, top_k: int, top_blocks: int, block_size: int, scale: float64, query_start: int, causal: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_blocked_cached(self.handle, key.handle, value.handle, summaries.handle, top_k, top_blocks, block_size, scale, query_start, causal)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_blocked_cached_routed(self, key: &Tensor, value: &Tensor, route: Tensor[int32], active_length: int, block_size: int, scale: float64, query_start: int, causal: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_blocked_cached_routed(self.handle, key.handle, value.handle, route.handle, active_length, block_size, scale, query_start, causal)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention_blocked_cached_active(self, key: &Tensor, value: &Tensor, summaries: &Tensor, active_length: int, top_k: int, top_blocks: int, block_size: int, scale: float64, query_start: int, causal: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_sparse_attention_blocked_cached_active(self.handle, key.handle, value.handle, summaries.handle, active_length, top_k, top_blocks, block_size, scale, query_start, causal)
        var result: Tensor = Tensor(handle)
        return result

    def masked_fill(self, mask: &Tensor, value: float64) -> Tensor:
        var neg_mask: Tensor = mask.mul_scalar(-1.0)
        var keep_mask: Tensor = neg_mask.add_scalar(1.0)
        var kept: Tensor = self.mul(keep_mask)
        var replacement: Tensor = mask.mul_scalar(value)
        var result: Tensor = kept.add(replacement)
        return result

    def row(self, row: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_row(self.handle, row)
        var value: Tensor = Tensor(handle)
        return value

    def column(self, column: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_column(self.handle, column)
        var value: Tensor = Tensor(handle)
        return value

    def slice(self, axis: int, start: int, stop: int, step: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_slice(self.handle, axis, start, stop, step)
        var value: Tensor = Tensor(handle)
        return value

    def sum(self) -> float64:
        return ocean_tensor_sum(self.handle)

    def mean(self) -> float64:
        return ocean_tensor_mean(self.handle)

    def max(self) -> float64:
        return ocean_tensor_max(self.handle)

    def min(self) -> float64:
        return ocean_tensor_min(self.handle)

    def item(self) -> float64:
        return ocean_tensor_item(self.handle)

    def dtype(self) -> str:
        return ocean_tensor_dtype_name(self.handle)

    def is_contiguous(self) -> bool:
        return ocean_tensor_is_contiguous(self.handle)

    def contiguous(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_tensor_contiguous(self.handle)
        var value: Tensor = Tensor(handle)
        return value

    def fill(self, value: float64) -> None:
        ocean_tensor_fill(self.handle, value)
        return None

    def get(self, row: int, col: int) -> float64:
        return ocean_tensor_get_2d(self.handle, row, col)

    def set(self, row: int, col: int, value: float64) -> None:
        ocean_tensor_set_2d(self.handle, row, col, value)
        return None

    def shape(self, axis: int) -> int:
        return ocean_tensor_shape(self.handle, axis)

    def ndim(self) -> int:
        return ocean_tensor_ndim(self.handle)

    def size(self) -> size_t:
        return ocean_tensor_size(self.handle)

    def device(self) -> str:
        return ocean_tensor_device(self.handle)

    def device_info(self) -> str:
        return ocean_tensor_device_info(self.handle)

    def sparse_attention_cuda_available(self) -> bool:
        return ocean_tensor_sparse_attention_cuda_available(self.handle)

    def release(self) -> None:
        ocean_tensor_release(self.handle)
        self.handle = None
        return None


# A page-backed K/V store. Pages are allocated lazily and routed attention
# reads them directly without materializing one contiguous cache.
class PagedKVCache:
    def __init__(self, handle: ocean_paged_kv_cache_handle_t):
        self.handle = handle

    @staticmethod
    def create(batches: int, heads: int, head_dim: int, page_size: int, device: str) -> PagedKVCache:
        var handle: ocean_paged_kv_cache_handle_t = ocean_paged_kv_cache_create(batches, heads, head_dim, page_size, device)
        var result: PagedKVCache = PagedKVCache(handle)
        return result

    @staticmethod
    def create_with_capacity(batches: int, heads: int, head_dim: int, page_size: int, max_seq_len: int, device: str) -> PagedKVCache:
        var handle: ocean_paged_kv_cache_handle_t = ocean_paged_kv_cache_create_with_capacity(batches, heads, head_dim, page_size, max_seq_len, device)
        var result: PagedKVCache = PagedKVCache(handle)
        return result

    def length(self) -> int:
        return ocean_paged_kv_cache_length(self.handle)

    def page_size(self) -> int:
        return ocean_paged_kv_cache_page_size(self.handle)

    def write(self, key: &Tensor, value: &Tensor, position: int) -> None:
        ocean_paged_kv_cache_write(self.handle, key.handle, value.handle, position)
        return None

    def materialize_key(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_paged_kv_cache_materialize_key(self.handle)
        var result: Tensor = Tensor(handle)
        return result

    def materialize_value(self) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_paged_kv_cache_materialize_value(self.handle)
        var result: Tensor = Tensor(handle)
        return result

    def sparse_attention(self, query: &Tensor, route: &Tensor, active_length: int, block_size: int, scale: float64, query_start: int, causal: bool) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_paged_kv_cache_sparse_attention_routed(self.handle, query.handle, route.handle, active_length, block_size, scale, query_start, causal)
        var result: Tensor = Tensor(handle)
        return result

    def build_summaries(self, active_length: int, block_size: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_paged_kv_cache_build_summaries(self.handle, active_length, block_size)
        var result: Tensor = Tensor(handle)
        return result

    def update_summary(self, summaries: &Tensor, active_length: int, position: int, block_size: int) -> None:
        ocean_paged_kv_cache_update_summary(self.handle, summaries.handle, active_length, position, block_size)
        return None

    def build_hierarchy(self, summaries: &Tensor, active_length: int, block_size: int) -> Tensor:
        var handle: ocean_tensor_handle_t = ocean_paged_kv_cache_build_hierarchy(summaries.handle, active_length, block_size)
        var result: Tensor = Tensor(handle)
        return result

    def update_hierarchy(self, hierarchy: &Tensor, summaries: &Tensor, active_length: int, position: int, block_size: int) -> None:
        ocean_paged_kv_cache_update_hierarchy(hierarchy.handle, summaries.handle, active_length, position, block_size)
        return None

    def build_route_hierarchical(self, hierarchy: &Tensor, active_length: int, summary_window: int, semantic_blocks: int, local_blocks: int, block_size: int, random_seed: int) -> Tensor[int32]:
        var handle: ocean_tensor_handle_t = ocean_paged_kv_cache_build_route_hierarchical(self.handle, hierarchy.handle, active_length, summary_window, semantic_blocks, local_blocks, block_size, random_seed)
        var result: Tensor[int32] = Tensor(handle)
        return result

    def update_route_hierarchical(self, route: Tensor[int32], hierarchy: &Tensor, active_length: int, summary_window: int, semantic_blocks: int, local_blocks: int, block_size: int, random_seed: int) -> None:
        ocean_paged_kv_cache_update_route_hierarchical(self.handle, route.handle, hierarchy.handle, active_length, summary_window, semantic_blocks, local_blocks, block_size, random_seed)
        return None

    def release(self) -> None:
        ocean_paged_kv_cache_release(self.handle)
        self.handle = None
        return None
