# std/multiprocessing/thread.oc
cimport <pthread.h>
cimport <stdlib.h>
cimport <std/multiprocessing/thread_backend.h>

class Thread:
    def __init__(self):
        # Выделяем память под C-структуру ocean_Thread
        unsafe:
            self.handle: *ocean_Thread = @malloc(sizeof(ocean_Thread))

    @staticmethod
    def create(start_routine: pointer, arg: pointer) -> Thread:
        var t: Thread = Thread()
        unsafe:
            var result: int = @ocean_thread_create(t.handle, start_routine, arg)
            if result != 0:
                @free(t.handle)
                t.handle = None
        return t

    def join(self) -> None:
        unsafe:
            @ocean_thread_join(self.handle)
            @free(self.handle)
        return None
