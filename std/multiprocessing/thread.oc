# std/multiprocessing/thread.oc
cimport <std/multiprocessing/thread_backend.h>

class Thread:
    def __init__(self, handle: ocean_thread_handle_t):
        self.handle = handle

    @staticmethod
    def create(start_routine: ocean_thread_fn_t, arg: *void) -> Thread:
        unsafe:
            var handle: ocean_thread_handle_t = @ocean_thread_create(start_routine, arg)
        return Thread(handle)

    def join(self) -> None:
        unsafe:
            @ocean_thread_join(self.handle)
        return None

    def detach(self) -> None:
        unsafe:
            @ocean_thread_detach(self.handle)
        return None

    def is_joinable(self) -> bool:
        unsafe:
            var result: bool = @ocean_thread_is_joinable(self.handle)
        return result
