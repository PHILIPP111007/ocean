    @staticmethod
    def nan() -> float64:
        unsafe:
            var result: float64 = @nan("")
        return result

    @staticmethod
    def radians(degrees: float64) -> float64:
        return degrees * 0.017453292519943295769236907684886127

    @staticmethod
    def degrees(radians: float64) -> float64:
        return radians * 57.295779513082320876798154814105170

    @staticmethod
    def clamp(value: float64, minimum: float64, maximum: float64) -> float64:
        if value < minimum:
            return minimum
        if value > maximum:
            return maximum
        return value

    @staticmethod
    def sign(value: float64) -> int:
        if value > 0.0:
            return 1
        if value < 0.0:
            return -1
        return 0

    @staticmethod
    def isclose(a: float64, b: float64, rel_tol: float64, abs_tol: float64) -> bool:
        var difference: float64 = Math.abs(a - b)
        var abs_a: float64 = Math.abs(a)
        var abs_b: float64 = Math.abs(b)
        var scale: float64 = abs_a

        if abs_b > scale:
            scale = abs_b

        var tolerance: float64 = rel_tol * scale

        if abs_tol > tolerance:
            tolerance = abs_tol

        return difference <= tolerance
