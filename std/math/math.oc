        return result

    @staticmethod
    def hypot(x: float64, y: float64) -> float64:
        unsafe:
            var result: float64 = @hypot(x, y)
        return result

    @staticmethod
    def min(x: float64, y: float64) -> float64:
        unsafe:
            var result: float64 = @fmin(x, y)
