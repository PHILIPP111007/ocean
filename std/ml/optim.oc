import <std/ml/nn.oc>
cimport <std/tensor/autograd_runtime.h>


class SGD:
    def __init__(self, parameters: list[Parameter], learning_rate: float64) -> None:
        self.parameters: list[Parameter] = parameters
        self.learning_rate: float64 = learning_rate

    def zero_grad(self) -> None:
        var parameters: list[Parameter] = self.parameters
        var index: int = 0

        while index < len(parameters):
            var parameter: Parameter = parameters[index]
            parameter.zero_grad()
            index = index + 1

        return None

    def step(self) -> None:
        var parameters: list[Parameter] = self.parameters
        var index: int = 0

        while index < len(parameters):
            var parameter: Parameter = parameters[index]
            parameter.step(self.learning_rate)
            index = index + 1

        return None


class AdamW:
    def __init__(self, parameters: list[Parameter], learning_rate: float64, beta1: float64, beta2: float64, epsilon: float64, weight_decay: float64) -> None:
        self.parameters: list[Parameter] = parameters
        self.learning_rate: float64 = learning_rate
        self.beta1: float64 = beta1
        self.beta2: float64 = beta2
        self.epsilon: float64 = epsilon
        self.weight_decay: float64 = weight_decay
        self.state_id: int = ocean_autograd_adamw_create()

    def zero_grad(self) -> None:
        var parameters: list[Parameter] = self.parameters
        var index: int = 0

        while index < len(parameters):
            var parameter: Parameter = parameters[index]
            parameter.zero_grad()
            index = index + 1

        return None

    def step(self) -> None:
        var parameters: list[Parameter] = self.parameters
        var current_step: int = ocean_autograd_adamw_begin_step(self.state_id)
        var index: int = 0

        while index < len(parameters):
            var parameter: Parameter = parameters[index]
            parameter.adamw_step(self.state_id, current_step, self.learning_rate, self.beta1, self.beta2, self.epsilon, self.weight_decay)
            index = index + 1

        return None

