# Universal fully connected layers composed through ordinary Ocean objects.
#
# DenseLayer is reusable: its input/output sizes and activation are supplied
# to the constructor. NeuralNetwork owns two independent DenseLayer objects
# and composes their forward/backward methods without touching their storage.

class DenseLayer:
    def __init__(self, input_size: int, output_size: int, activation: int) -> None:
        self.input_size: int = input_size
        self.output_size: int = output_size
        self.activation: int = activation
        self.weights: tensor[float32] = tensor.zeros(input_size, output_size)
        self.bias: tensor[float32] = tensor.zeros(1, output_size)

    def initialize(self, initial_weight: float32) -> None:
        for i in range(self.input_size):
            for j in range(self.output_size):
                self.weights[i, j] = initial_weight

        for j in range(self.output_size):
            self.bias[0, j] = 0.0

        return None

    def forward(self, inputs: &tensor[float32]) -> tensor[float32]:
        var outputs: tensor[float32] = tensor.zeros(1, self.output_size)

        for j in range(self.output_size):
            var value: float32 = self.bias[0, j]
            for i in range(self.input_size):
                value = value + inputs[0, i] * self.weights[i, j]

            if self.activation == 1:
                if value > 0.0:
                    outputs[0, j] = value
                else:
                    outputs[0, j] = 0.0
            else:
                outputs[0, j] = value

        return outputs

    def backward(self, inputs: &tensor[float32], outputs: &tensor[float32], upstream: &tensor[float32], learning_rate: float32) -> tensor[float32]:
        var input_gradient: tensor[float32] = tensor.zeros(1, self.input_size)

        for j in range(self.output_size):
            var gradient: float32 = upstream[0, j]

            if self.activation == 1:
                if outputs[0, j] <= 0.0:
                    gradient = 0.0

            for i in range(self.input_size):
                var previous_weight: float32 = self.weights[i, j]
                var propagated: float32 = input_gradient[0, i]
                propagated = propagated + gradient * previous_weight
                input_gradient[0, i] = propagated
                self.weights[i, j] = previous_weight + learning_rate * gradient * inputs[0, i] * -1.0

            self.bias[0, j] = self.bias[0, j] + learning_rate * gradient * -1.0

        return input_gradient


class NeuralNetwork:
    def __init__(self, input_size: int, hidden_size: int, output_size: int) -> None:
        # Fields are objects, not duplicated parameter buffers. This is the
        # composition point that makes DenseLayer independently reusable.
        self.hidden: DenseLayer = DenseLayer(input_size, hidden_size, 1)
        self.output: DenseLayer = DenseLayer(hidden_size, output_size, 0)

    def initialize(self, initial_weight: float32) -> None:
        self.hidden.initialize(initial_weight)
        self.output.initialize(initial_weight)
        return None

    def forward(self, inputs: &tensor[float32]) -> tensor[float32]:
        var hidden_outputs: tensor[float32] = self.hidden.forward(inputs)
        var outputs: tensor[float32] = self.output.forward(hidden_outputs)
        return outputs

    def train_step(self, inputs: &tensor[float32], target: &tensor[float32], learning_rate: float32) -> float32:
        var hidden_outputs: tensor[float32] = self.hidden.forward(inputs)
        var outputs: tensor[float32] = self.output.forward(hidden_outputs)
        var output_gradient: tensor[float32] = tensor.zeros(1, self.output.output_size)
        var error: float32 = outputs[0, 0] + target[0, 0] * -1.0
        output_gradient[0, 0] = error

        var hidden_gradient: tensor[float32] = self.output.backward(hidden_outputs, outputs, output_gradient, learning_rate)
        var input_gradient: tensor[float32] = self.hidden.backward(inputs, hidden_outputs, hidden_gradient, learning_rate)

        return error * error

    def predict(self, inputs: &tensor[float32]) -> float32:
        var outputs: tensor[float32] = self.forward(inputs)
        var result: float32 = outputs[0, 0]
        return result


def main() -> int:
    var network: NeuralNetwork = NeuralNetwork(2, 4, 1)
    network.initialize(0.1)

    var inputs: tensor[float32] = [[1.0, 0.0]]
    var target: tensor[float32] = [[1.0]]
    var loss: float32 = 0.0

    for _ in range(20):
        loss = network.train_step(inputs, target, 0.1)

    var prediction: float32 = network.predict(inputs)
    print("prediction =", prediction)
    print("loss =", loss)
    return 0
