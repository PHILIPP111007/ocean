cimport <pthread.h>

def worker(arg: None) -> None:
    unsafe:
        @printf("worker: started, arg=%p\n", arg)
    return None


def main() -> int:
    var thread: pthread_t = 0

    unsafe:
        @pthread_create(&thread, NULL, worker, NULL)
        @pthread_join(thread, NULL)

    print("main: worker joined")
    return 0
