import <std/multiprocessing/thread.oc>









def my_worker(arg: None) -> None:
    unsafe:
        var num: int = *(int*)arg
        @printf("Worker: arg = %d\n", num)
    return

def main() -> int:
    var value: int = 42
    var thread: Thread = Thread.create(my_worker, &value)
    thread.join()
    print("Main: worker finished")
    return 0
