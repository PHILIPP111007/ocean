import <std/tensor/tensor.oc>


def main() -> int:
    var size: int = 100

    var A: Tensor[float32] = Tensor.zeros(size, size, "cpu")
    var B: Tensor[float32] = Tensor.zeros(size, size, "cpu")
    for i in range(size):
        A[i, i] = 1.0
        B[i, i] = 2.0

    for _ in range(1000):
        var C: Tensor[float32] = A.matmul(B)

    return 0
