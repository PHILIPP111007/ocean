import <std/tensor/tensor.oc>

def matmul(A: &Tensor[float32], B: &Tensor[float32], C: &mut Tensor[float32]) -> None:
    var rows_A: int = A.shape(0)
    var cols_A: int = A.shape(1)
    var cols_B: int = B.shape(1)

    #pragma omp parallel for collapse(2)
    for i in range(rows_A):
        for j in range(cols_B):
            var sum_value: float32 = 0.0

            for k in range(cols_A):
                sum_value = sum_value + A[i, k] * B[k, j]

            C[i, j] = sum_value

    return None


def main() -> int:
    var size: int = 100

    var A: Tensor[float32] = Tensor.zeros(size, size, "cpu")
    var B: Tensor[float32] = Tensor.zeros(size, size, "cpu")
    var C: Tensor[float32] = Tensor.zeros(size, size, "cpu")
    for i in range(size):
        A[i, i] = 1.0
        B[i, i] = 2.0

    for _ in range(1000):
        matmul(A, B, C)

    print("C[0, 0] =", C[0, 0])
    print("C.shape(0) =", C.shape(0))
    print("C.shape(1) =", C.shape(1))
    print("C.size() =", C.size())

    return 0
