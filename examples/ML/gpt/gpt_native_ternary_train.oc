import <std/tensor/tensor.oc>
import <std/ml/nn.oc>
import <std/ml/optim.oc>
cimport <math.h>


# Native ternary training experiment for Ocean.
#
# Model:
#   vocab_size     = 48
#   context_length = 32
#   d_model        = 64
#   n_heads        = 4
#   d_ff           = 256
#   n_layers       = 3
#
# Compared with TinyGPT v0.1 this is substantially larger, but still small
# enough to use as a compiler/runtime training regression.
#
# The ternary model keeps:
#   Embedding  -> full precision
#   LayerNorm  -> full precision
#   LM head    -> full precision
#
# and trains all Attention/MLP Linear weights through a ternary forward:
#
#   W_q in {-scale, 0, +scale}
#
# while AdamW updates the full-precision master Parameter.
#
# STE is built entirely from existing Ocean Tensor semantics:
#
#   detached = master.copy()
#   delta    = quantized - detached
#   W_ste    = master + delta
#
# Tensor.copy() is a raw value copy rather than an autograd operation, so
# delta has no gradient edge back to master. Therefore:
#
#   forward(W_ste)  == quantized
#   dW_ste/dmaster  == 1
#
# This first experiment intentionally runs on CPU because ternarization uses
# Tensor.get()/set() loops. Once quality is demonstrated, ternary packing and
# vectorized CPU/GPU kernels should move into the runtime.


class TernaryLinear(Module):
    def __init__(self, in_features: int, out_features: int) -> None:
        self.training: bool = True
        self.in_features: int = in_features
        self.out_features: int = out_features

        var weight_tensor: Tensor[float32] = Tensor(ocean_autograd_parameter_uniform(out_features, in_features, 0.1, "cpu"))
        var weight_parameter: Parameter = Parameter(weight_tensor)
        self.weight: Parameter = weight_parameter

        var bias_tensor: Tensor[float32] = Tensor.zeros(1, out_features, "cpu")
        self.bias: Parameter = Parameter(bias_tensor)

    def ternary_weight(self) -> Tensor[float32]:
        # Full-precision master parameter.
        var master: Tensor[float32] = self.weight.tensor()

        # Raw Tensor.copy() creates the detached value snapshot used to
        # construct the STE expression.
        var detached: Tensor[float32] = master.copy()

        var rows: int = self.out_features
        var cols: int = self.in_features

        var sum_abs: float64 = 0.0
        var row: int = 0

        while row < rows:
            var col: int = 0

            while col < cols:
                var value: float64 = detached.get(row, col)

                if value < 0.0:
                    sum_abs = sum_abs - value
                else:
                    sum_abs = sum_abs + value

                col = col + 1

            row = row + 1

        var count: float64 = rows * cols
        var scale: float64 = sum_abs / count

        if scale < 0.00000001:
            scale = 0.00000001

        # round(w / scale) clipped to {-1, 0, +1} is equivalent to
        # thresholds at +/- 0.5 * scale.
        var threshold: float64 = 0.5 * scale

        var quantized: Tensor[float32] = Tensor.zeros(rows, cols, "cpu")

        row = 0

        while row < rows:
            var col2: int = 0

            while col2 < cols:
                var value2: float64 = detached.get(row, col2)

                if value2 > threshold:
                    quantized.set(row, col2, scale)
                else:
                    if value2 < -threshold:
                        quantized.set(row, col2, -scale)
                    else:
                        quantized.set(row, col2, 0.0)

                col2 = col2 + 1

            row = row + 1

        # Straight-through estimator:
        #
        # forward:
        #   master + (quantized - detached) == quantized
        #
        # backward:
        #   only master participates in autograd => gradient is identity.
        var delta: Tensor[float32] = quantized.sub(detached)
        var ste_weight: Tensor[float32] = master.add(delta)

        return ste_weight

    def forward(self, input: &Tensor[float32]) -> Tensor[float32]:
        var weight: Tensor[float32] = self.ternary_weight()
        var weight_t: Tensor[float32] = weight.transpose()
        var projected: Tensor[float32] = input.matmul(weight_t)

        var bias: Tensor[float32] = self.bias.tensor()
        var result: Tensor[float32] = projected.add(bias)

        return result

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.weight, self.bias]
        return result

    def zero_fraction(self) -> float64:
        var master: Tensor[float32] = self.weight.tensor()
        var detached: Tensor[float32] = master.copy()

        var rows: int = self.out_features
        var cols: int = self.in_features

        var sum_abs: float64 = 0.0
        var row: int = 0

        while row < rows:
            var col: int = 0

            while col < cols:
                var value: float64 = detached.get(row, col)

                if value < 0.0:
                    sum_abs = sum_abs - value
                else:
                    sum_abs = sum_abs + value

                col = col + 1

            row = row + 1

        var count: float64 = rows * cols
        var scale: float64 = sum_abs / count

        if scale < 0.00000001:
            scale = 0.00000001

        var threshold: float64 = 0.5 * scale
        var zeros: int = 0

        row = 0

        while row < rows:
            var col2: int = 0

            while col2 < cols:
                var value2: float64 = detached.get(row, col2)

                if value2 <= threshold:
                    if value2 >= -threshold:
                        zeros = zeros + 1

                col2 = col2 + 1

            row = row + 1

        return zeros / count


class TernaryMultiHeadAttention(Module):
    def __init__(self, d_model: int, n_heads: int) -> None:
        self.training: bool = True
        self.d_model: int = d_model
        self.n_heads: int = n_heads
        self.head_dim: int = d_model // n_heads

        self.q_proj: TernaryLinear = TernaryLinear(d_model, d_model)
        self.k_proj: TernaryLinear = TernaryLinear(d_model, d_model)
        self.v_proj: TernaryLinear = TernaryLinear(d_model, d_model)
        self.out_proj: TernaryLinear = TernaryLinear(d_model, d_model)

    def forward(self, input: &Tensor[float32], causal_mask: &Tensor[float32]) -> Tensor[float32]:
        var batch_size: int = input.shape(0)
        var sequence_length: int = input.shape(1)

        var q_linear: Tensor[float32] = self.q_proj.forward(input)
        var k_linear: Tensor[float32] = self.k_proj.forward(input)
        var v_linear: Tensor[float32] = self.v_proj.forward(input)

        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])

        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])

        var k_t: Tensor[float32] = k.transpose(-2, -1)
        var scores: Tensor[float32] = q.matmul(k_t)

        var attention_scale: float64 = sqrt(self.head_dim)
        var scaled: Tensor[float32] = scores.div_scalar(attention_scale)
        var masked: Tensor[float32] = scaled.masked_fill(causal_mask, -1000000000.0)
        var weights: Tensor[float32] = masked.softmax(-1)
        var context: Tensor[float32] = weights.matmul(v)

        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, sequence_length, self.d_model])

        return self.out_proj.forward(merged)

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.q_proj.weight, self.q_proj.bias, self.k_proj.weight, self.k_proj.bias, self.v_proj.weight, self.v_proj.bias, self.out_proj.weight, self.out_proj.bias]
        return result


class TernaryTransformerBlock(Module):
    def __init__(self, d_model: int, n_heads: int, d_ff: int) -> None:
        self.training: bool = True
        self.d_model: int = d_model
        self.n_heads: int = n_heads
        self.d_ff: int = d_ff

        self.norm1: LayerNorm = LayerNorm(d_model, 0.00001)
        self.attention: TernaryMultiHeadAttention = TernaryMultiHeadAttention(d_model, n_heads)

        self.norm2: LayerNorm = LayerNorm(d_model, 0.00001)
        self.ff1: TernaryLinear = TernaryLinear(d_model, d_ff)
        self.ff2: TernaryLinear = TernaryLinear(d_ff, d_model)

    def forward(self, input: &Tensor[float32], causal_mask: &Tensor[float32]) -> Tensor[float32]:
        var normalized1: Tensor[float32] = self.norm1.forward(input)
        var attention_output: Tensor[float32] = self.attention.forward(normalized1, causal_mask)
        var residual1: Tensor[float32] = input.add(attention_output)

        var normalized2: Tensor[float32] = self.norm2.forward(residual1)
        var hidden: Tensor[float32] = self.ff1.forward(normalized2)
        var activated: Tensor[float32] = hidden.relu()
        var feed_forward: Tensor[float32] = self.ff2.forward(activated)

        return residual1.add(feed_forward)

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.norm1.gamma, self.norm1.beta, self.attention.q_proj.weight, self.attention.q_proj.bias, self.attention.k_proj.weight, self.attention.k_proj.bias, self.attention.v_proj.weight, self.attention.v_proj.bias, self.attention.out_proj.weight, self.attention.out_proj.bias, self.norm2.gamma, self.norm2.beta, self.ff1.weight, self.ff1.bias, self.ff2.weight, self.ff2.bias]
        return result


class MediumGPT(Module):
    def __init__(self, vocab_size: int, context_length: int, d_model: int, n_heads: int, d_ff: int) -> None:
        self.training: bool = True
        self.vocab_size: int = vocab_size
        self.context_length: int = context_length
        self.d_model: int = d_model

        self.token_embedding: Embedding = Embedding(vocab_size, d_model)
        self.position_embedding: Embedding = Embedding(context_length, d_model)

        self.block1: TransformerBlock = TransformerBlock(d_model, n_heads, d_ff)
        self.block2: TransformerBlock = TransformerBlock(d_model, n_heads, d_ff)
        self.block3: TransformerBlock = TransformerBlock(d_model, n_heads, d_ff)

        self.final_norm: LayerNorm = LayerNorm(d_model, 0.00001)
        self.lm_head: Linear = Linear(d_model, vocab_size)

    def forward(self, tokens: &Tensor[int64], positions: &Tensor[int64], causal_mask: &Tensor[float32]) -> Tensor[float32]:
        var token_hidden: Tensor[float32] = self.token_embedding.forward(tokens)
        var position_hidden: Tensor[float32] = self.position_embedding.forward(positions)

        var hidden0: Tensor[float32] = token_hidden.add(position_hidden)
        var hidden1: Tensor[float32] = self.block1.forward(hidden0, causal_mask)
        var hidden2: Tensor[float32] = self.block2.forward(hidden1, causal_mask)
        var hidden3: Tensor[float32] = self.block3.forward(hidden2, causal_mask)

        var normalized: Tensor[float32] = self.final_norm.forward(hidden3)
        return self.lm_head.forward(normalized)

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.token_embedding.weight, self.position_embedding.weight, self.block1.norm1.gamma, self.block1.norm1.beta, self.block1.attention.q_proj.weight, self.block1.attention.q_proj.bias, self.block1.attention.k_proj.weight, self.block1.attention.k_proj.bias, self.block1.attention.v_proj.weight, self.block1.attention.v_proj.bias, self.block1.attention.out_proj.weight, self.block1.attention.out_proj.bias, self.block1.norm2.gamma, self.block1.norm2.beta, self.block1.ff1.weight, self.block1.ff1.bias, self.block1.ff2.weight, self.block1.ff2.bias, self.block2.norm1.gamma, self.block2.norm1.beta, self.block2.attention.q_proj.weight, self.block2.attention.q_proj.bias, self.block2.attention.k_proj.weight, self.block2.attention.k_proj.bias, self.block2.attention.v_proj.weight, self.block2.attention.v_proj.bias, self.block2.attention.out_proj.weight, self.block2.attention.out_proj.bias, self.block2.norm2.gamma, self.block2.norm2.beta, self.block2.ff1.weight, self.block2.ff1.bias, self.block2.ff2.weight, self.block2.ff2.bias, self.block3.norm1.gamma, self.block3.norm1.beta, self.block3.attention.q_proj.weight, self.block3.attention.q_proj.bias, self.block3.attention.k_proj.weight, self.block3.attention.k_proj.bias, self.block3.attention.v_proj.weight, self.block3.attention.v_proj.bias, self.block3.attention.out_proj.weight, self.block3.attention.out_proj.bias, self.block3.norm2.gamma, self.block3.norm2.beta, self.block3.ff1.weight, self.block3.ff1.bias, self.block3.ff2.weight, self.block3.ff2.bias, self.final_norm.gamma, self.final_norm.beta, self.lm_head.weight, self.lm_head.bias]
        return result


class MediumTernaryGPT(Module):
    def __init__(self, vocab_size: int, context_length: int, d_model: int, n_heads: int, d_ff: int) -> None:
        self.training: bool = True
        self.vocab_size: int = vocab_size
        self.context_length: int = context_length
        self.d_model: int = d_model

        # Keep embeddings full precision for the first native ternary
        # experiment.
        self.token_embedding: Embedding = Embedding(vocab_size, d_model)
        self.position_embedding: Embedding = Embedding(context_length, d_model)

        self.block1: TernaryTransformerBlock = TernaryTransformerBlock(d_model, n_heads, d_ff)
        self.block2: TernaryTransformerBlock = TernaryTransformerBlock(d_model, n_heads, d_ff)
        self.block3: TernaryTransformerBlock = TernaryTransformerBlock(d_model, n_heads, d_ff)

        self.final_norm: LayerNorm = LayerNorm(d_model, 0.00001)

        # Keep lm_head full precision initially. Once convergence is proven,
        # this can be tested as ternary separately.
        self.lm_head: Linear = Linear(d_model, vocab_size)

    def forward(self, tokens: &Tensor[int64], positions: &Tensor[int64], causal_mask: &Tensor[float32]) -> Tensor[float32]:
        var token_hidden: Tensor[float32] = self.token_embedding.forward(tokens)
        var position_hidden: Tensor[float32] = self.position_embedding.forward(positions)

        var hidden0: Tensor[float32] = token_hidden.add(position_hidden)
        var hidden1: Tensor[float32] = self.block1.forward(hidden0, causal_mask)
        var hidden2: Tensor[float32] = self.block2.forward(hidden1, causal_mask)
        var hidden3: Tensor[float32] = self.block3.forward(hidden2, causal_mask)

        var normalized: Tensor[float32] = self.final_norm.forward(hidden3)
        return self.lm_head.forward(normalized)

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.token_embedding.weight, self.position_embedding.weight, self.block1.norm1.gamma, self.block1.norm1.beta, self.block1.attention.q_proj.weight, self.block1.attention.q_proj.bias, self.block1.attention.k_proj.weight, self.block1.attention.k_proj.bias, self.block1.attention.v_proj.weight, self.block1.attention.v_proj.bias, self.block1.attention.out_proj.weight, self.block1.attention.out_proj.bias, self.block1.norm2.gamma, self.block1.norm2.beta, self.block1.ff1.weight, self.block1.ff1.bias, self.block1.ff2.weight, self.block1.ff2.bias, self.block2.norm1.gamma, self.block2.norm1.beta, self.block2.attention.q_proj.weight, self.block2.attention.q_proj.bias, self.block2.attention.k_proj.weight, self.block2.attention.k_proj.bias, self.block2.attention.v_proj.weight, self.block2.attention.v_proj.bias, self.block2.attention.out_proj.weight, self.block2.attention.out_proj.bias, self.block2.norm2.gamma, self.block2.norm2.beta, self.block2.ff1.weight, self.block2.ff1.bias, self.block2.ff2.weight, self.block2.ff2.bias, self.block3.norm1.gamma, self.block3.norm1.beta, self.block3.attention.q_proj.weight, self.block3.attention.q_proj.bias, self.block3.attention.k_proj.weight, self.block3.attention.k_proj.bias, self.block3.attention.v_proj.weight, self.block3.attention.v_proj.bias, self.block3.attention.out_proj.weight, self.block3.attention.out_proj.bias, self.block3.norm2.gamma, self.block3.norm2.beta, self.block3.ff1.weight, self.block3.ff1.bias, self.block3.ff2.weight, self.block3.ff2.bias, self.final_norm.gamma, self.final_norm.beta, self.lm_head.weight, self.lm_head.bias]
        return result

    def representative_zero_fraction(self) -> float64:
        # Cheap diagnostic from one representative matrix.
        return self.block1.ff1.zero_fraction()


def fill_positions(positions: &mut Tensor[int64], sequence_length: int) -> None:
    var index: int = 0

    while index < sequence_length:
        positions[0, index] = index
        index = index + 1

    return None


def fill_causal_mask(mask: &mut Tensor[float32], sequence_length: int) -> None:
    var row: int = 0

    while row < sequence_length:
        var col: int = 0

        while col < sequence_length:
            if col > row:
                mask[row, col] = 1.0

            col = col + 1

        row = row + 1

    return None


def fill_language_batch(tokens: &mut Tensor[int64], targets: &mut Tensor[int64], batch_size: int, sequence_length: int, vocab_size: int, seed_offset: int) -> None:
    # Deterministic synthetic language.
    #
    # Each sequence follows a second-order recurrence:
    #
    #   next = (previous + current + 3) % vocab
    #
    # Different rows receive different seeds. Therefore the model needs
    # context rather than only memorizing one fixed next-token lookup.
    var row: int = 0

    while row < batch_size:
        var previous: int = (seed_offset + row * 5 + 1) % vocab_size

        var current: int = (seed_offset * 3 + row * 7 + 2) % vocab_size

        var col: int = 0

        while col < sequence_length:
            tokens[row, col] = previous
            targets[row, col] = current

            var next_token: int = (previous + current + 3) % vocab_size

            previous = current
            current = next_token

            col = col + 1

        row = row + 1

    return None


def evaluate_fp(model: &MediumGPT, tokens: &Tensor[int64], targets: &Tensor[int64], positions: &Tensor[int64], mask: &Tensor[float32], criterion: &CrossEntropyLoss) -> float64:
    var logits: Tensor[float32] = model.forward(tokens, positions, mask)

    var loss: Tensor[float32] = criterion.forward(logits, targets)

    return loss.item()


def evaluate_ternary(model: &MediumTernaryGPT, tokens: &Tensor[int64], targets: &Tensor[int64], positions: &Tensor[int64], mask: &Tensor[float32], criterion: &CrossEntropyLoss) -> float64:
    var logits: Tensor[float32] = model.forward(tokens, positions, mask)

    var loss: Tensor[float32] = criterion.forward(logits, targets)

    return loss.item()


def train_fp(model: &MediumGPT, tokens: &Tensor[int64], targets: &Tensor[int64], positions: &Tensor[int64], mask: &Tensor[float32], steps: int) -> None:
    var parameters: list[Parameter] = model.parameters()

    var optimizer: AdamW = AdamW(parameters, 0.001, 0.9, 0.999, 0.00000001, 0.01)

    var criterion: CrossEntropyLoss = CrossEntropyLoss()

    var step: int = 0

    while step < steps:
        optimizer.zero_grad()

        var logits: Tensor[float32] = model.forward(tokens, positions, mask)

        var loss: Tensor[float32] = criterion.forward(logits, targets)

        loss.backward()
        optimizer.step()

        if step % 25 == 0:
            print("[fp32] step =", step, "loss =", loss.item())

        step = step + 1

    return None


def train_ternary(model: &MediumTernaryGPT, tokens: &Tensor[int64], targets: &Tensor[int64], positions: &Tensor[int64], mask: &Tensor[float32], steps: int) -> None:
    var parameters: list[Parameter] = model.parameters()

    var optimizer: AdamW = AdamW(parameters, 0.001, 0.9, 0.999, 0.00000001, 0.01)

    var criterion: CrossEntropyLoss = CrossEntropyLoss()

    var step: int = 0

    while step < steps:
        optimizer.zero_grad()

        var logits: Tensor[float32] = model.forward(tokens, positions, mask)

        var loss: Tensor[float32] = criterion.forward(logits, targets)

        loss.backward()
        optimizer.step()

        if step % 25 == 0:
            print("[ternary] step =", step, "loss =", loss.item())

        step = step + 1

    return None


def main() -> int:
    var vocab_size: int = 48
    var context_length: int = 32
    var d_model: int = 64
    var n_heads: int = 4
    var d_ff: int = 256

    var train_batch_size: int = 4
    var eval_batch_size: int = 2
    var training_steps: int = 250

    var train_tokens: Tensor[int64] = Tensor.zeros(train_batch_size, context_length, "cpu")
    var train_targets: Tensor[int64] = Tensor.zeros(train_batch_size, context_length, "cpu")

    var eval_tokens: Tensor[int64] = Tensor.zeros(eval_batch_size, context_length, "cpu")
    var eval_targets: Tensor[int64] = Tensor.zeros(eval_batch_size, context_length, "cpu")

    var positions: Tensor[int64] = Tensor.zeros(1, context_length, "cpu")

    var mask: Tensor[float32] = Tensor.zeros(context_length, context_length, "cpu")

    fill_positions(positions, context_length)

    fill_causal_mask(mask, context_length)

    fill_language_batch(train_tokens, train_targets, train_batch_size, context_length, vocab_size, 0)

    # Unseen seeds for validation.
    fill_language_batch(eval_tokens, eval_targets, eval_batch_size, context_length, vocab_size, 100)

    print("========================================")
    print("Ocean native ternary GPT experiment")
    print("========================================")
    print("layers =", 3)
    print("d_model =", d_model)
    print("heads =", n_heads)
    print("d_ff =", d_ff)
    print("context =", context_length)
    print("vocab =", vocab_size)
    print("steps =", training_steps)

    var fp_model: MediumGPT = MediumGPT(vocab_size, context_length, d_model, n_heads, d_ff)

    var ternary_model: MediumTernaryGPT = MediumTernaryGPT(vocab_size, context_length, d_model, n_heads, d_ff)

    var criterion: CrossEntropyLoss = CrossEntropyLoss()

    var fp_initial_train: float64 = evaluate_fp(fp_model, train_tokens, train_targets, positions, mask, criterion)

    var fp_initial_eval: float64 = evaluate_fp(fp_model, eval_tokens, eval_targets, positions, mask, criterion)

    var ternary_initial_train: float64 = evaluate_ternary(ternary_model, train_tokens, train_targets, positions, mask, criterion)

    var ternary_initial_eval: float64 = evaluate_ternary(ternary_model, eval_tokens, eval_targets, positions, mask, criterion)

    print("")
    print("INITIAL")
    print("fp32 train loss =", fp_initial_train)
    print("fp32 eval loss =", fp_initial_eval)
    print("ternary train loss =", ternary_initial_train)
    print("ternary eval loss =", ternary_initial_eval)

    print("")
    print("TRAIN FP32")
    train_fp(fp_model, train_tokens, train_targets, positions, mask, training_steps)

    print("")
    print("TRAIN TERNARY")
    train_ternary(ternary_model, train_tokens, train_targets, positions, mask, training_steps)

    var fp_final_train: float64 = evaluate_fp(fp_model, train_tokens, train_targets, positions, mask, criterion)

    var fp_final_eval: float64 = evaluate_fp(fp_model, eval_tokens, eval_targets, positions, mask, criterion)

    var ternary_final_train: float64 = evaluate_ternary(ternary_model, train_tokens, train_targets, positions, mask, criterion)

    var ternary_final_eval: float64 = evaluate_ternary(ternary_model, eval_tokens, eval_targets, positions, mask, criterion)

    var zero_fraction: float64 = ternary_model.representative_zero_fraction()

    print("")
    print("========================================")
    print("FINAL COMPARISON")
    print("========================================")
    print("fp32 initial train loss =", fp_initial_train)
    print("fp32 final train loss =", fp_final_train)
    print("fp32 initial eval loss =", fp_initial_eval)
    print("fp32 final eval loss =", fp_final_eval)
    print("")
    print("ternary initial train loss =", ternary_initial_train)
    print("ternary final train loss =", ternary_final_train)
    print("ternary initial eval loss =", ternary_initial_eval)
    print("ternary final eval loss =", ternary_final_eval)
    print("")
    print("representative ternary zero fraction =", zero_fraction)
    print("")
    print("[ok] Ocean MediumGPT FP32 vs native ternary training")

    return 0
