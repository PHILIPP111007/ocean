import "./gpt2_native_ternary_model.oc"
import <std/ml/optim.oc>


def train(model: &GPT2Ternary, tokens: &Tensor[int64], targets: &Tensor[int64], positions: &Tensor[int64], causal_bias: &Tensor[float32], steps: int) -> None:
    var parameters: list[Parameter] = model.parameters()
    var optimizer: AdamW = AdamW(parameters, 0.001, 0.9, 0.999, 0.00000001, 0.01)
    var criterion: CrossEntropyLoss = CrossEntropyLoss()
    var step: int = 0

    while step < steps:
        optimizer.zero_grad()
        var logits: Tensor[float32] = model.forward(tokens, positions, causal_bias)
        var loss: Tensor[float32] = criterion.forward(logits, targets)
        loss.backward()
        optimizer.step()

        if step % 10 == 0:
            print("step =", step, "loss =", loss.item())
        step = step + 1
    return None


def main() -> int:
    # The model accepts the canonical GPT-2 small dimensions.  This executable
    # remains a training smoke test; inference throughput lives in the separate
    # gpt2_native_ternary_inference.oc example.
    var config: GPT2Config = gpt2_small_config()
    var batch_size: int = 2
    var sequence_length: int = 16
    var steps: int = 3

    var tokens: Tensor[int64] = Tensor.zeros(batch_size, sequence_length, "cpu")
    var targets: Tensor[int64] = Tensor.zeros(batch_size, sequence_length, "cpu")
    var positions: Tensor[int64] = Tensor.zeros(1, sequence_length, "cpu")
    var causal_bias: Tensor[float32] = Tensor.zeros(sequence_length, sequence_length, "cpu")

    fill_recurrence_batch(tokens, targets, batch_size, sequence_length, config.vocab_size)
    fill_positions(positions, sequence_length)
    fill_causal_bias(causal_bias, sequence_length)

    var model: GPT2Ternary = GPT2Ternary(config)
    model.to("gpu")

    var tokens_gpu: Tensor[int64] = tokens.to("gpu")
    var targets_gpu: Tensor[int64] = targets.to("gpu")
    var positions_gpu: Tensor[int64] = positions.to("gpu")
    var causal_bias_gpu: Tensor[float32] = causal_bias.to("gpu")

    var criterion: CrossEntropyLoss = CrossEntropyLoss()
    var initial_logits: Tensor[float32] = model.forward(tokens_gpu, positions_gpu, causal_bias_gpu)
    var initial_loss: Tensor[float32] = criterion.forward(initial_logits, targets_gpu)

    train(model, tokens_gpu, targets_gpu, positions_gpu, causal_bias_gpu, steps)

    var final_logits: Tensor[float32] = model.forward(tokens_gpu, positions_gpu, causal_bias_gpu)
    var final_loss: Tensor[float32] = criterion.forward(final_logits, targets_gpu)

    var model_parameters: list[Parameter] = model.parameters()
    var token_embedding_weight: Tensor[float32] = model.token_embedding.weight.tensor()
    print("model device =", token_embedding_weight.device())
    print("GPT2 ternary parameters =", len(model_parameters))
    print("initial loss =", initial_loss.item())
    print("final loss =", final_loss.item())
    print("[ok] Ocean GPT2 native ternary")
    return 0
