import <std/tensor/tensor.oc>
import <std/ml/nn.oc>
cimport <math.h>


# GPT-2-style decoder-only language model with ternary forward weights.
#
# The architecture follows GPT-2's important invariants:
#
#   token embedding + learned position embedding
#   pre-layernorm decoder blocks
#   causal multi-head self-attention
#   4x feed-forward expansion
#   GELU activation
#   final LayerNorm
#   tied token-embedding / language-model head
#
# TernaryLinear keeps a full-precision master Parameter and constructs a
# straight-through ternary weight for every forward:
#
#   W_ste = W_master + (ternary(W_master) - W_master.copy())
#
# Therefore the forward uses {-scale, 0, +scale}, while the optimizer updates
# the full-precision master weight. This is weight-only ternarization; token
# and position embedding lookups remain full precision, as in the first
# practical training milestone.


class GPT2Config:
    def __init__(self, vocab_size: int, max_seq_len: int, d_model: int, n_heads: int, d_ff: int, n_layers: int) -> None:
        self.vocab_size: int = vocab_size
        self.max_seq_len: int = max_seq_len
        self.d_model: int = d_model
        self.n_heads: int = n_heads
        self.d_ff: int = d_ff
        self.n_layers: int = n_layers


class GPT2Embedding(Module):
    def __init__(self, vocab_size: int, d_model: int) -> None:
        self.training: bool = True
        self.vocab_size: int = vocab_size
        self.d_model: int = d_model

        # GPT-2 initializes token and position embeddings from N(0, 0.02).
        # std.ml.Embedding intentionally keeps its older 0.1 default for
        # compatibility with existing examples, so GPT-2 owns this exact
        # initialization locally.
        var weight_tensor: Tensor[float32] = Tensor(ocean_autograd_parameter_uniform(vocab_size, d_model, 0.02, "cpu"))
        self.weight: Parameter = Parameter(weight_tensor)

    def forward(self, input: &Tensor[int64]) -> Tensor[float32]:
        var weight: Tensor[float32] = self.weight.tensor()
        var weight_handle: ocean_tensor_handle_t = weight.raw_handle()
        var input_handle: ocean_tensor_handle_t = input.raw_handle()
        var handle: ocean_tensor_handle_t = ocean_autograd_embedding(weight_handle, input_handle)
        return Tensor(handle)

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.weight]
        return result


def gpt2_small_config() -> GPT2Config:
    # Canonical GPT-2 small: n_vocab=50257, n_ctx=1024, n_embd=768,
    # n_head=12, n_inner=3072, n_layer=12.
    var config: GPT2Config = GPT2Config(50257, 1024, 768, 12, 3072, 12)
    return config


class TernaryLinear(Module):
    def __init__(self, in_features: int, out_features: int) -> None:
        self.training: bool = True
        self.in_features: int = in_features
        self.out_features: int = out_features

        # Matmul-ready [in_features, out_features] layout avoids a transpose
        # in every forward. The master uses GPT-2's small initialization scale.
        var weight_tensor: Tensor[float32] = Tensor(ocean_autograd_parameter_uniform(in_features, out_features, 0.02, "cpu"))
        self.weight: Parameter = Parameter(weight_tensor)
        var bias_tensor: Tensor[float32] = Tensor.zeros(1, out_features, "cpu")
        self.bias: Parameter = Parameter(bias_tensor)
        self.inference_packed_weight: Tensor[int32] = Tensor.zeros(0, 0, "cpu")
        self.inference_scale: float64 = 0.0
        self.inference_ready: bool = False
        self.inference_frozen: bool = False

    def ternary_weight(self) -> Tensor[float32]:
        var master: Tensor[float32] = self.weight.tensor()
        var detached: Tensor[float32] = master.copy()
        var quantized: Tensor[float32] = master.ternary_quantize()
        var delta: Tensor[float32] = quantized.sub(detached)
        var ste_weight: Tensor[float32] = master.add(delta)
        return ste_weight

    def weight_for_forward(self) -> Tensor[float32]:
        return self.ternary_weight()

    def forward(self, input: &Tensor[float32]) -> Tensor[float32]:
        var gradients_enabled: bool = Tensor.grad_enabled()
        if self.inference_ready and (gradients_enabled == False or self.inference_frozen):
            var packed_bias: Tensor[float32] = self.bias.tensor()
            return input.packed_linear_inference(self.inference_packed_weight, self.inference_scale, packed_bias, self.out_features)
        var weight: Tensor[float32] = self.weight_for_forward()
        if gradients_enabled == False:
            var bias_for_inference: Tensor[float32] = self.bias.tensor()
            return input.linear_inference(weight, bias_for_inference)
        var projected: Tensor[float32] = input.matmul(weight)
        var bias: Tensor[float32] = self.bias.tensor()
        return projected.add(bias)

    def prepare_inference(self) -> None:
        if self.inference_ready == False:
            var master: Tensor[float32] = self.weight.tensor()
            self.inference_scale = master.ternary_scale()
            self.inference_packed_weight = master.ternary_pack(self.inference_scale, False)
            self.inference_ready = True
        return None

    def freeze_for_inference(self) -> None:
        if self.inference_frozen == False:
            self.prepare_inference()
            self.weight.release_data()
            self.inference_frozen = True
        return None

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.weight, self.bias]
        return result


class GPT2KVCache:
    def __init__(self, n_heads: int, max_seq_len: int, head_dim: int, device: str) -> None:
        self.k1: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v1: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k2: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v2: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k3: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v3: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k4: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v4: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k5: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v5: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k6: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v6: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k7: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v7: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k8: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v8: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k9: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v9: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k10: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v10: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k11: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v11: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.k12: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)
        self.v12: Tensor[float32] = Tensor.zeros(1, n_heads, max_seq_len, head_dim, device)

        var summary_blocks: int = (max_seq_len + 63) / 64
        self.s1: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s2: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s3: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s4: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s5: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s6: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s7: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s8: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s9: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s10: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s11: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)
        self.s12: Tensor[float32] = Tensor.zeros(1, n_heads, summary_blocks, head_dim, device)

        # Sticky routes keep two latest blocks local, add five cosine-selected
        # semantic blocks, and add one deterministic exploration block. A
        # route is refreshed every 50 decoded tokens from the latest 100 keys.
        self.r1: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r2: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r3: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r4: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r5: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r6: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r7: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r8: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r9: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r10: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r11: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.r12: Tensor[int32] = Tensor.zeros(1, n_heads, 8, device)
        self.route_age1: int = 50
        self.route_age2: int = 50
        self.route_age3: int = 50
        self.route_age4: int = 50
        self.route_age5: int = 50
        self.route_age6: int = 50
        self.route_age7: int = 50
        self.route_age8: int = 50
        self.route_age9: int = 50
        self.route_age10: int = 50
        self.route_age11: int = 50
        self.route_age12: int = 50

    def prepare_sparse(self, active_length: int, n_layers: int) -> None:
        if n_layers > 0:
            self.s1 = self.k1.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 1:
            self.s2 = self.k2.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 2:
            self.s3 = self.k3.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 3:
            self.s4 = self.k4.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 4:
            self.s5 = self.k5.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 5:
            self.s6 = self.k6.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 6:
            self.s7 = self.k7.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 7:
            self.s8 = self.k8.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 8:
            self.s9 = self.k9.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 9:
            self.s10 = self.k10.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 10:
            self.s11 = self.k11.sparse_attention_build_summaries_active(active_length, 64)
        if n_layers > 11:
            self.s12 = self.k12.sparse_attention_build_summaries_active(active_length, 64)
        return None


class GPT2Attention(Module):
    def __init__(self, d_model: int, n_heads: int) -> None:
        self.training: bool = True
        self.d_model: int = d_model
        self.n_heads: int = n_heads
        self.head_dim: int = d_model // n_heads

        # Separate projections preserve the current ND Tensor API while
        # remaining mathematically equivalent to GPT-2's c_attn projection.
        self.q_proj: TernaryLinear = TernaryLinear(d_model, d_model)
        self.k_proj: TernaryLinear = TernaryLinear(d_model, d_model)
        self.v_proj: TernaryLinear = TernaryLinear(d_model, d_model)
        self.out_proj: TernaryLinear = TernaryLinear(d_model, d_model)
        self.sparse_top_k: int = 128
        # GPT2KVCache allocates this route width as 2 local + 5 semantic +
        # 1 exploration = 8.
        self.sparse_top_blocks: int = 5
        self.sparse_local_blocks: int = 2
        self.sparse_block_size: int = 64
        self.sparse_prefill_threshold: int = 256
        self.last_prefill_sparse: bool = False

    def forward(self, input: &Tensor[float32], causal_bias: &Tensor[float32]) -> Tensor[float32]:
        if Tensor.grad_enabled() == False and self.q_proj.inference_ready and self.k_proj.inference_ready and self.v_proj.inference_ready:
            return self.forward_fused(input, causal_bias)
        var batch_size: int = input.shape(0)
        var sequence_length: int = input.shape(1)

        var q_linear: Tensor[float32] = self.q_proj.forward(input)
        var k_linear: Tensor[float32] = self.k_proj.forward(input)
        var v_linear: Tensor[float32] = self.v_proj.forward(input)

        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])

        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])

        var k_t: Tensor[float32] = k.transpose(-2, -1)
        var scores: Tensor[float32] = q.matmul(k_t)
        var scale: float64 = sqrt(self.head_dim)
        var scaled: Tensor[float32] = scores.div_scalar(scale)

        # The bias is zero on visible positions and -1e9 in the future.
        # Addition is cheaper than the generic masked_fill composition.
        var masked: Tensor[float32] = scaled.add(causal_bias)
        var weights: Tensor[float32] = masked.softmax(-1)
        var context: Tensor[float32] = weights.matmul(v)

        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, sequence_length, self.d_model])
        return self.out_proj.forward(merged)

    def forward_fused(self, input: &Tensor[float32], causal_bias: &Tensor[float32]) -> Tensor[float32]:
        var batch_size: int = input.shape(0)
        var sequence_length: int = input.shape(1)
        var q_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        var k_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        var v_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        input.packed_qkv_inference_into(self.q_proj.inference_packed_weight, self.q_proj.inference_scale, self.q_proj.bias.tensor(), self.k_proj.inference_packed_weight, self.k_proj.inference_scale, self.k_proj.bias.tensor(), self.v_proj.inference_packed_weight, self.v_proj.inference_scale, self.v_proj.bias.tensor(), q_linear, k_linear, v_linear, self.d_model)
        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])
        var k_t: Tensor[float32] = k.transpose(-2, -1)
        var scores: Tensor[float32] = q.matmul(k_t)
        var scaled: Tensor[float32] = scores.div_scalar(sqrt(self.head_dim))
        var masked: Tensor[float32] = scaled.add(causal_bias)
        var weights: Tensor[float32] = masked.softmax(-1)
        var context: Tensor[float32] = weights.matmul(v)
        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, sequence_length, self.d_model])
        return self.out_proj.forward(merged)

    def forward_prefill(self, input: &Tensor[float32], cache_k: &Tensor[float32], cache_v: &Tensor[float32]) -> Tensor[float32]:
        if Tensor.grad_enabled() == False and self.q_proj.inference_ready and self.k_proj.inference_ready and self.v_proj.inference_ready:
            return self.forward_prefill_fused(input, cache_k, cache_v)
        var batch_size: int = input.shape(0)
        var sequence_length: int = input.shape(1)

        var q_linear: Tensor[float32] = self.q_proj.forward(input)
        var k_linear: Tensor[float32] = self.k_proj.forward(input)
        var v_linear: Tensor[float32] = self.v_proj.forward(input)

        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])

        cache_k.cache_write(k, 0)
        cache_v.cache_write(v, 0)
        var key_transposed: Tensor[float32] = k.transpose_dims(-2, -1)
        var scores: Tensor[float32] = q.matmul(key_transposed)
        var scaled: Tensor[float32] = scores.div_scalar(sqrt(self.head_dim))
        var weights: Tensor[float32] = scaled.causal_softmax()
        var context: Tensor[float32] = weights.matmul(v)
        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, sequence_length, self.d_model])
        return self.out_proj.forward(merged)

    def forward_cached(self, input: &Tensor[float32], cache_k: &Tensor[float32], cache_v: &Tensor[float32], summary: &Tensor[float32], route: &Tensor[int32], refresh_route: bool, position: int) -> Tensor[float32]:
        if input.device() == "gpu" and input.sparse_attention_cuda_available() and Tensor.grad_enabled() == False and self.q_proj.inference_ready and self.k_proj.inference_ready and self.v_proj.inference_ready:
            return self.forward_cached_sparse(input, cache_k, cache_v, summary, route, refresh_route, position)
        var batch_size: int = input.shape(0)
        var q_linear: Tensor[float32] = self.q_proj.forward(input)
        var k_linear: Tensor[float32] = self.k_proj.forward(input)
        var v_linear: Tensor[float32] = self.v_proj.forward(input)

        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, 1, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, 1, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, 1, self.n_heads, self.head_dim])
        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])

        cache_k.cache_write(k, position)
        cache_v.cache_write(v, position)
        var keys: Tensor[float32] = cache_k.slice(2, 0, position + 1, 1)
        var values: Tensor[float32] = cache_v.slice(2, 0, position + 1, 1)
        var key_transposed: Tensor[float32] = keys.transpose_dims(-2, -1)
        var scores: Tensor[float32] = q.matmul(key_transposed)
        var scaled: Tensor[float32] = scores.div_scalar(sqrt(self.head_dim))
        var weights: Tensor[float32] = scaled.softmax(-1)
        var context: Tensor[float32] = weights.matmul(values)
        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, 1, self.d_model])
        return self.out_proj.forward(merged)

    def forward_prefill_fused(self, input: &Tensor[float32], cache_k: &Tensor[float32], cache_v: &Tensor[float32]) -> Tensor[float32]:
        var batch_size: int = input.shape(0)
        var sequence_length: int = input.shape(1)
        self.last_prefill_sparse = False
        if input.device() == "gpu" and input.sparse_attention_cuda_available() and sequence_length >= self.sparse_prefill_threshold:
            self.last_prefill_sparse = True
            return self.forward_prefill_sparse(input, cache_k, cache_v)
        var q_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        var k_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        var v_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        input.packed_qkv_inference_into(self.q_proj.inference_packed_weight, self.q_proj.inference_scale, self.q_proj.bias.tensor(), self.k_proj.inference_packed_weight, self.k_proj.inference_scale, self.k_proj.bias.tensor(), self.v_proj.inference_packed_weight, self.v_proj.inference_scale, self.v_proj.bias.tensor(), q_linear, k_linear, v_linear, self.d_model)
        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])
        cache_k.cache_write(k, 0)
        cache_v.cache_write(v, 0)
        var key_transposed: Tensor[float32] = k.transpose_dims(-2, -1)
        var scores: Tensor[float32] = q.matmul(key_transposed)
        var scaled: Tensor[float32] = scores.div_scalar(sqrt(self.head_dim))
        var weights: Tensor[float32] = scaled.causal_softmax()
        var context: Tensor[float32] = weights.matmul(v)
        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, sequence_length, self.d_model])
        return self.out_proj.forward(merged)

    def forward_prefill_sparse(self, input: &Tensor[float32], cache_k: &Tensor[float32], cache_v: &Tensor[float32]) -> Tensor[float32]:
        var batch_size: int = input.shape(0)
        var sequence_length: int = input.shape(1)
        var q_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        var k_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        var v_linear: Tensor[float32] = Tensor.empty(batch_size, sequence_length, self.d_model, input.device())
        input.packed_qkv_inference_into(self.q_proj.inference_packed_weight, self.q_proj.inference_scale, self.q_proj.bias.tensor(), self.k_proj.inference_packed_weight, self.k_proj.inference_scale, self.k_proj.bias.tensor(), self.v_proj.inference_packed_weight, self.v_proj.inference_scale, self.v_proj.bias.tensor(), q_linear, k_linear, v_linear, self.d_model)
        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, sequence_length, self.n_heads, self.head_dim])
        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])
        cache_k.cache_write(k, 0)
        cache_v.cache_write(v, 0)
        var summary: Tensor[float32] = cache_k.sparse_attention_build_summaries_active(sequence_length, self.sparse_block_size)
        var context: Tensor[float32] = Tensor.empty(batch_size, self.n_heads, sequence_length, self.head_dim, input.device())
        var chunk_start: int = 0
        while chunk_start < sequence_length:
            var chunk_end: int = chunk_start + 50
            if chunk_end > sequence_length:
                chunk_end = sequence_length
            var route: Tensor[int32] = cache_k.sparse_attention_build_route_active(summary, chunk_end, 100, self.sparse_top_blocks, self.sparse_local_blocks, self.sparse_block_size, chunk_start + self.n_heads + self.d_model)
            var query_chunk: Tensor[float32] = q.slice(2, chunk_start, chunk_end, 1)
            var context_chunk: Tensor[float32] = query_chunk.sparse_attention_blocked_cached_routed(cache_k, cache_v, route, sequence_length, self.sparse_block_size, 1.0 / sqrt(self.head_dim), chunk_start, True)
            var context_view: Tensor[float32] = context.slice(2, chunk_start, chunk_end, 1)
            context_view.copy_into(context_chunk)
            chunk_start = chunk_end
        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, sequence_length, self.d_model])
        return self.out_proj.forward(merged)

    def set_sparse_prefill_threshold(self, threshold: int) -> None:
        self.sparse_prefill_threshold = threshold
        return None

    def prefill_sparse_used(self) -> bool:
        return self.last_prefill_sparse

    def forward_cached_sparse(self, input: &Tensor[float32], cache_k: &Tensor[float32], cache_v: &Tensor[float32], summary: &Tensor[float32], route: &Tensor[int32], refresh_route: bool, position: int) -> Tensor[float32]:
        var batch_size: int = input.shape(0)
        var q_linear: Tensor[float32] = Tensor.empty(batch_size, 1, self.d_model, input.device())
        var k_linear: Tensor[float32] = Tensor.empty(batch_size, 1, self.d_model, input.device())
        var v_linear: Tensor[float32] = Tensor.empty(batch_size, 1, self.d_model, input.device())
        input.packed_qkv_inference_into(self.q_proj.inference_packed_weight, self.q_proj.inference_scale, self.q_proj.bias.tensor(), self.k_proj.inference_packed_weight, self.k_proj.inference_scale, self.k_proj.bias.tensor(), self.v_proj.inference_packed_weight, self.v_proj.inference_scale, self.v_proj.bias.tensor(), q_linear, k_linear, v_linear, self.d_model)
        var q_reshaped: Tensor[float32] = q_linear.reshape([batch_size, 1, self.n_heads, self.head_dim])
        var k_reshaped: Tensor[float32] = k_linear.reshape([batch_size, 1, self.n_heads, self.head_dim])
        var v_reshaped: Tensor[float32] = v_linear.reshape([batch_size, 1, self.n_heads, self.head_dim])
        var q: Tensor[float32] = q_reshaped.permute([0, 2, 1, 3])
        var k: Tensor[float32] = k_reshaped.permute([0, 2, 1, 3])
        var v: Tensor[float32] = v_reshaped.permute([0, 2, 1, 3])
        cache_k.cache_write(k, position)
        cache_v.cache_write(v, position)
        var active_length: int = position + 1
        summary.sparse_attention_update_summary_active(cache_k, active_length, position, self.sparse_block_size)
        if refresh_route:
            cache_k.sparse_attention_update_route_active(summary, route, active_length, 100, self.sparse_top_blocks, self.sparse_local_blocks, self.sparse_block_size, position + self.n_heads + self.d_model)
        var context: Tensor[float32] = q.sparse_attention_blocked_cached_routed(cache_k, cache_v, route, active_length, self.sparse_block_size, 1.0 / sqrt(self.head_dim), position, True)
        var context_bthd: Tensor[float32] = context.permute([0, 2, 1, 3])
        var merged: Tensor[float32] = context_bthd.reshape([batch_size, 1, self.d_model])
        return self.out_proj.forward(merged)

    def prepare_inference(self) -> None:
        self.q_proj.prepare_inference()
        self.k_proj.prepare_inference()
        self.v_proj.prepare_inference()
        self.out_proj.prepare_inference()
        return None

    def freeze_for_inference(self) -> None:
        self.q_proj.freeze_for_inference()
        self.k_proj.freeze_for_inference()
        self.v_proj.freeze_for_inference()
        self.out_proj.freeze_for_inference()
        return None

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.q_proj.weight, self.q_proj.bias, self.k_proj.weight, self.k_proj.bias, self.v_proj.weight, self.v_proj.bias, self.out_proj.weight, self.out_proj.bias]
        return result


class GPT2MLP(Module):
    def __init__(self, d_model: int, d_ff: int) -> None:
        self.training: bool = True
        self.fc: TernaryLinear = TernaryLinear(d_model, d_ff)
        self.proj: TernaryLinear = TernaryLinear(d_ff, d_model)

    def forward(self, input: &Tensor[float32]) -> Tensor[float32]:
        var hidden: Tensor[float32] = self.fc.forward(input)
        var activated: Tensor[float32] = hidden.gelu()
        return self.proj.forward(activated)

    def prepare_inference(self) -> None:
        self.fc.prepare_inference()
        self.proj.prepare_inference()
        return None

    def freeze_for_inference(self) -> None:
        self.fc.freeze_for_inference()
        self.proj.freeze_for_inference()
        return None

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.fc.weight, self.fc.bias, self.proj.weight, self.proj.bias]
        return result


class GPT2Block(Module):
    def __init__(self, d_model: int, n_heads: int, d_ff: int) -> None:
        self.training: bool = True
        self.ln_1: LayerNorm = LayerNorm(d_model, 0.00001)
        self.attn: GPT2Attention = GPT2Attention(d_model, n_heads)
        self.ln_2: LayerNorm = LayerNorm(d_model, 0.00001)
        self.mlp: GPT2MLP = GPT2MLP(d_model, d_ff)

    def forward(self, input: &Tensor[float32], causal_bias: &Tensor[float32]) -> Tensor[float32]:
        var normalized: Tensor[float32] = self.ln_1.forward(input)
        var attention_output: Tensor[float32] = self.attn.forward(normalized, causal_bias)
        var residual: Tensor[float32] = input.add(attention_output)

        var normalized2: Tensor[float32] = self.ln_2.forward(residual)
        var feed_forward: Tensor[float32] = self.mlp.forward(normalized2)
        return residual.add(feed_forward)

    def prepare_inference(self) -> None:
        self.attn.prepare_inference()
        self.mlp.prepare_inference()
        return None

    def freeze_for_inference(self) -> None:
        self.attn.freeze_for_inference()
        self.mlp.freeze_for_inference()
        return None

    def forward_prefill(self, input: &Tensor[float32], cache_k: &Tensor[float32], cache_v: &Tensor[float32]) -> Tensor[float32]:
        var normalized: Tensor[float32] = self.ln_1.forward(input)
        var attention_output: Tensor[float32] = self.attn.forward_prefill(normalized, cache_k, cache_v)
        var residual: Tensor[float32] = input.add(attention_output)
        var normalized2: Tensor[float32] = self.ln_2.forward(residual)
        var feed_forward: Tensor[float32] = self.mlp.forward(normalized2)
        return residual.add(feed_forward)

    def forward_cached(self, input: &Tensor[float32], cache_k: &Tensor[float32], cache_v: &Tensor[float32], summary: &Tensor[float32], route: &Tensor[int32], refresh_route: bool, position: int) -> Tensor[float32]:
        var normalized: Tensor[float32] = self.ln_1.forward(input)
        var attention_output: Tensor[float32] = self.attn.forward_cached(normalized, cache_k, cache_v, summary, route, refresh_route, position)
        var residual: Tensor[float32] = input.add(attention_output)
        var normalized2: Tensor[float32] = self.ln_2.forward(residual)
        var feed_forward: Tensor[float32] = self.mlp.forward(normalized2)
        return residual.add(feed_forward)

    def set_sparse_prefill_threshold(self, threshold: int) -> None:
        self.attn.set_sparse_prefill_threshold(threshold)
        return None

    def parameters(self) -> list[Parameter]:
        var result: list[Parameter] = [self.ln_1.gamma, self.ln_1.beta]
        var attention_parameters: list[Parameter] = self.attn.parameters()
        var index: int = 0
        while index < len(attention_parameters):
            result.append(attention_parameters[index])
            index = index + 1

        result.append(self.ln_2.gamma)
        result.append(self.ln_2.beta)
        var mlp_parameters: list[Parameter] = self.mlp.parameters()
        var mlp_index: int = 0
        while mlp_index < len(mlp_parameters):
            result.append(mlp_parameters[mlp_index])
            mlp_index = mlp_index + 1
        return result


class GPT2Ternary(Module):
    def __init__(self, config: GPT2Config) -> None:
        self.training: bool = True
        self.vocab_size: int = config.vocab_size
        self.max_seq_len: int = config.max_seq_len
        self.d_model: int = config.d_model
        self.n_heads: int = config.n_heads
        self.n_layers: int = config.n_layers

        self.token_embedding: GPT2Embedding = GPT2Embedding(config.vocab_size, config.d_model)
        self.position_embedding: GPT2Embedding = GPT2Embedding(config.max_seq_len, config.d_model)
        # The current compiler does not yet initialize ARC list fields in
        # constructors reliably. Keep the model fully configurable up to the
        # canonical GPT-2 small depth with explicit block fields meanwhile.
        self.block1: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block2: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block3: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block4: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block5: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block6: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block7: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block8: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block9: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block10: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block11: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.block12: GPT2Block = GPT2Block(config.d_model, config.n_heads, config.d_ff)
        self.ln_f: LayerNorm = LayerNorm(config.d_model, 0.00001)
        self.inference_lm_packed: Tensor[int32] = Tensor.zeros(0, 0, "cpu")
        self.inference_lm_scale: float64 = 0.0
        self.inference_lm_ready: bool = False

    def tied_lm_weight(self) -> Tensor[float32]:
        # GPT-2 ties the output projection to the token embedding matrix.
        # Quantize the tied weight with STE, then transpose to [C, V].
        var master: Tensor[float32] = self.token_embedding.weight.tensor()
        var detached: Tensor[float32] = master.copy()
        var quantized: Tensor[float32] = master.ternary_quantize()
        var delta: Tensor[float32] = quantized.sub(detached)
        var ste_embedding: Tensor[float32] = master.add(delta)
        return ste_embedding.transpose()

    def forward(self, tokens: &Tensor[int64], positions: &Tensor[int64], causal_bias: &Tensor[float32]) -> Tensor[float32]:
        var token_hidden: Tensor[float32] = self.token_embedding.forward(tokens)
        var position_hidden: Tensor[float32] = self.position_embedding.forward(positions)
        var hidden: Tensor[float32] = token_hidden.add(position_hidden)

        if self.n_layers > 0:
            hidden = self.block1.forward(hidden, causal_bias)
        if self.n_layers > 1:
            hidden = self.block2.forward(hidden, causal_bias)
        if self.n_layers > 2:
            hidden = self.block3.forward(hidden, causal_bias)
        if self.n_layers > 3:
            hidden = self.block4.forward(hidden, causal_bias)
        if self.n_layers > 4:
            hidden = self.block5.forward(hidden, causal_bias)
        if self.n_layers > 5:
            hidden = self.block6.forward(hidden, causal_bias)
        if self.n_layers > 6:
            hidden = self.block7.forward(hidden, causal_bias)
        if self.n_layers > 7:
            hidden = self.block8.forward(hidden, causal_bias)
        if self.n_layers > 8:
            hidden = self.block9.forward(hidden, causal_bias)
        if self.n_layers > 9:
            hidden = self.block10.forward(hidden, causal_bias)
        if self.n_layers > 10:
            hidden = self.block11.forward(hidden, causal_bias)
        if self.n_layers > 11:
            hidden = self.block12.forward(hidden, causal_bias)

        var normalized: Tensor[float32] = self.ln_f.forward(hidden)
        var gradients_enabled: bool = Tensor.grad_enabled()
        if gradients_enabled == False and self.inference_lm_ready:
            return normalized.packed_matmul_inference(self.inference_lm_packed, self.inference_lm_scale, self.vocab_size)
        var lm_weight: Tensor[float32] = self.tied_lm_weight()
        return normalized.matmul(lm_weight)

    def prepare_inference(self) -> None:
        if self.inference_lm_ready == False:
            var master_embedding: Tensor[float32] = self.token_embedding.weight.tensor()
            self.inference_lm_scale = master_embedding.ternary_scale()
            self.inference_lm_packed = master_embedding.ternary_pack(self.inference_lm_scale, True)
            self.inference_lm_ready = True
        if self.n_layers > 0:
            self.block1.prepare_inference()
        if self.n_layers > 1:
            self.block2.prepare_inference()
        if self.n_layers > 2:
            self.block3.prepare_inference()
        if self.n_layers > 3:
            self.block4.prepare_inference()
        if self.n_layers > 4:
            self.block5.prepare_inference()
        if self.n_layers > 5:
            self.block6.prepare_inference()
        if self.n_layers > 6:
            self.block7.prepare_inference()
        if self.n_layers > 7:
            self.block8.prepare_inference()
        if self.n_layers > 8:
            self.block9.prepare_inference()
        if self.n_layers > 9:
            self.block10.prepare_inference()
        if self.n_layers > 10:
            self.block11.prepare_inference()
        if self.n_layers > 11:
            self.block12.prepare_inference()
        return None

    def freeze_for_inference(self) -> None:
        # Keep token/position embeddings in FP32: they are still used for
        # embedding lookup. Only the linear master weights are released after
        # their packed ternary inference copies are ready.
        self.prepare_inference()
        if self.n_layers > 0:
            self.block1.freeze_for_inference()
        if self.n_layers > 1:
            self.block2.freeze_for_inference()
        if self.n_layers > 2:
            self.block3.freeze_for_inference()
        if self.n_layers > 3:
            self.block4.freeze_for_inference()
        if self.n_layers > 4:
            self.block5.freeze_for_inference()
        if self.n_layers > 5:
            self.block6.freeze_for_inference()
        if self.n_layers > 6:
            self.block7.freeze_for_inference()
        if self.n_layers > 7:
            self.block8.freeze_for_inference()
        if self.n_layers > 8:
            self.block9.freeze_for_inference()
        if self.n_layers > 9:
            self.block10.freeze_for_inference()
        if self.n_layers > 10:
            self.block11.freeze_for_inference()
        if self.n_layers > 11:
            self.block12.freeze_for_inference()
        return None

    def set_sparse_prefill_threshold(self, threshold: int) -> None:
        if self.n_layers > 0:
            self.block1.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 1:
            self.block2.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 2:
            self.block3.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 3:
            self.block4.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 4:
            self.block5.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 5:
            self.block6.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 6:
            self.block7.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 7:
            self.block8.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 8:
            self.block9.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 9:
            self.block10.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 10:
            self.block11.set_sparse_prefill_threshold(threshold)
        if self.n_layers > 11:
            self.block12.set_sparse_prefill_threshold(threshold)
        return None

    def prefill_sparse_used(self) -> bool:
        if self.n_layers > 0:
            return self.block1.attn.prefill_sparse_used()
        return False

    def forward_prefill_hidden(self, tokens: &Tensor[int64], positions: &Tensor[int64], cache: &GPT2KVCache) -> Tensor[float32]:
        var token_hidden: Tensor[float32] = self.token_embedding.forward(tokens)
        var position_hidden: Tensor[float32] = self.position_embedding.forward(positions)
        var hidden: Tensor[float32] = token_hidden.add(position_hidden)

        if self.n_layers > 0:
            hidden = self.block1.forward_prefill(hidden, cache.k1, cache.v1)
        if self.n_layers > 1:
            hidden = self.block2.forward_prefill(hidden, cache.k2, cache.v2)
        if self.n_layers > 2:
            hidden = self.block3.forward_prefill(hidden, cache.k3, cache.v3)
        if self.n_layers > 3:
            hidden = self.block4.forward_prefill(hidden, cache.k4, cache.v4)
        if self.n_layers > 4:
            hidden = self.block5.forward_prefill(hidden, cache.k5, cache.v5)
        if self.n_layers > 5:
            hidden = self.block6.forward_prefill(hidden, cache.k6, cache.v6)
        if self.n_layers > 6:
            hidden = self.block7.forward_prefill(hidden, cache.k7, cache.v7)
        if self.n_layers > 7:
            hidden = self.block8.forward_prefill(hidden, cache.k8, cache.v8)
        if self.n_layers > 8:
            hidden = self.block9.forward_prefill(hidden, cache.k9, cache.v9)
        if self.n_layers > 9:
            hidden = self.block10.forward_prefill(hidden, cache.k10, cache.v10)
        if self.n_layers > 10:
            hidden = self.block11.forward_prefill(hidden, cache.k11, cache.v11)
        if self.n_layers > 11:
            hidden = self.block12.forward_prefill(hidden, cache.k12, cache.v12)

        if cache.k1.sparse_attention_cuda_available():
            cache.prepare_sparse(tokens.shape(1), self.n_layers)
        return self.ln_f.forward(hidden)

    def new_kv_cache(self, device: str) -> GPT2KVCache:
        return GPT2KVCache(self.n_heads, self.max_seq_len, self.d_model // self.n_heads, device)

    def forward_cached_hidden(self, tokens: &Tensor[int64], positions: &Tensor[int64], cache: &mut GPT2KVCache, position: int) -> Tensor[float32]:
        var token_hidden: Tensor[float32] = self.token_embedding.forward(tokens)
        var position_hidden: Tensor[float32] = self.position_embedding.forward(positions)
        var hidden: Tensor[float32] = token_hidden.add(position_hidden)

        if self.n_layers > 0:
            var refresh1: bool = cache.route_age1 >= 50
            hidden = self.block1.forward_cached(hidden, cache.k1, cache.v1, cache.s1, cache.r1, refresh1, position)
            if refresh1:
                cache.route_age1 = 0
            else:
                cache.route_age1 = cache.route_age1 + 1
        if self.n_layers > 1:
            var refresh2: bool = cache.route_age2 >= 50
            hidden = self.block2.forward_cached(hidden, cache.k2, cache.v2, cache.s2, cache.r2, refresh2, position)
            if refresh2:
                cache.route_age2 = 0
            else:
                cache.route_age2 = cache.route_age2 + 1
        if self.n_layers > 2:
            var refresh3: bool = cache.route_age3 >= 50
            hidden = self.block3.forward_cached(hidden, cache.k3, cache.v3, cache.s3, cache.r3, refresh3, position)
            if refresh3:
                cache.route_age3 = 0
            else:
                cache.route_age3 = cache.route_age3 + 1
        if self.n_layers > 3:
            var refresh4: bool = cache.route_age4 >= 50
            hidden = self.block4.forward_cached(hidden, cache.k4, cache.v4, cache.s4, cache.r4, refresh4, position)
            if refresh4:
                cache.route_age4 = 0
            else:
                cache.route_age4 = cache.route_age4 + 1
        if self.n_layers > 4:
            var refresh5: bool = cache.route_age5 >= 50
            hidden = self.block5.forward_cached(hidden, cache.k5, cache.v5, cache.s5, cache.r5, refresh5, position)
            if refresh5:
                cache.route_age5 = 0
            else:
                cache.route_age5 = cache.route_age5 + 1
        if self.n_layers > 5:
            var refresh6: bool = cache.route_age6 >= 50
            hidden = self.block6.forward_cached(hidden, cache.k6, cache.v6, cache.s6, cache.r6, refresh6, position)
            if refresh6:
                cache.route_age6 = 0
            else:
                cache.route_age6 = cache.route_age6 + 1
        if self.n_layers > 6:
            var refresh7: bool = cache.route_age7 >= 50
            hidden = self.block7.forward_cached(hidden, cache.k7, cache.v7, cache.s7, cache.r7, refresh7, position)
            if refresh7:
                cache.route_age7 = 0
            else:
                cache.route_age7 = cache.route_age7 + 1
        if self.n_layers > 7:
            var refresh8: bool = cache.route_age8 >= 50
            hidden = self.block8.forward_cached(hidden, cache.k8, cache.v8, cache.s8, cache.r8, refresh8, position)
            if refresh8:
                cache.route_age8 = 0
            else:
                cache.route_age8 = cache.route_age8 + 1
        if self.n_layers > 8:
            var refresh9: bool = cache.route_age9 >= 50
            hidden = self.block9.forward_cached(hidden, cache.k9, cache.v9, cache.s9, cache.r9, refresh9, position)
            if refresh9:
                cache.route_age9 = 0
            else:
                cache.route_age9 = cache.route_age9 + 1
        if self.n_layers > 9:
            var refresh10: bool = cache.route_age10 >= 50
            hidden = self.block10.forward_cached(hidden, cache.k10, cache.v10, cache.s10, cache.r10, refresh10, position)
            if refresh10:
                cache.route_age10 = 0
            else:
                cache.route_age10 = cache.route_age10 + 1
        if self.n_layers > 10:
            var refresh11: bool = cache.route_age11 >= 50
            hidden = self.block11.forward_cached(hidden, cache.k11, cache.v11, cache.s11, cache.r11, refresh11, position)
            if refresh11:
                cache.route_age11 = 0
            else:
                cache.route_age11 = cache.route_age11 + 1
        if self.n_layers > 11:
            var refresh12: bool = cache.route_age12 >= 50
            hidden = self.block12.forward_cached(hidden, cache.k12, cache.v12, cache.s12, cache.r12, refresh12, position)
            if refresh12:
                cache.route_age12 = 0
            else:
                cache.route_age12 = cache.route_age12 + 1

        var normalized: Tensor[float32] = self.ln_f.forward(hidden)
        return normalized

    def forward_cached(self, tokens: &Tensor[int64], positions: &Tensor[int64], cache: &mut GPT2KVCache, position: int) -> Tensor[float32]:
        var normalized: Tensor[float32] = self.forward_cached_hidden(tokens, positions, cache, position)
        var lm_weight: Tensor[float32] = self.tied_lm_weight()
        return normalized.matmul(lm_weight)

    def logits_from_hidden(self, hidden: &Tensor[float32], lm_weight: &Tensor[float32]) -> Tensor[float32]:
        return hidden.matmul(lm_weight)

    def packed_logits_from_hidden(self, hidden: &Tensor[float32]) -> Tensor[float32]:
        return hidden.packed_matmul_inference(self.inference_lm_packed, self.inference_lm_scale, self.vocab_size)

    def parameters(self) -> list[Parameter]:
        # The tied LM head is not a second Parameter.
        var result: list[Parameter] = [self.token_embedding.weight, self.position_embedding.weight]
        if self.n_layers > 0:
            var block1_parameters: list[Parameter] = self.block1.parameters()
            var block1_index: int = 0
            while block1_index < len(block1_parameters):
                result.append(block1_parameters[block1_index])
                block1_index = block1_index + 1
        if self.n_layers > 1:
            var block2_parameters: list[Parameter] = self.block2.parameters()
            var block2_index: int = 0
            while block2_index < len(block2_parameters):
                result.append(block2_parameters[block2_index])
                block2_index = block2_index + 1
        if self.n_layers > 2:
            var block3_parameters: list[Parameter] = self.block3.parameters()
            var block3_index: int = 0
            while block3_index < len(block3_parameters):
                result.append(block3_parameters[block3_index])
                block3_index = block3_index + 1
        if self.n_layers > 3:
            var block4_parameters: list[Parameter] = self.block4.parameters()
            var block4_index: int = 0
            while block4_index < len(block4_parameters):
                result.append(block4_parameters[block4_index])
                block4_index = block4_index + 1
        if self.n_layers > 4:
            var block5_parameters: list[Parameter] = self.block5.parameters()
            var block5_index: int = 0
            while block5_index < len(block5_parameters):
                result.append(block5_parameters[block5_index])
                block5_index = block5_index + 1
        if self.n_layers > 5:
            var block6_parameters: list[Parameter] = self.block6.parameters()
            var block6_index: int = 0
            while block6_index < len(block6_parameters):
                result.append(block6_parameters[block6_index])
                block6_index = block6_index + 1
        if self.n_layers > 6:
            var block7_parameters: list[Parameter] = self.block7.parameters()
            var block7_index: int = 0
            while block7_index < len(block7_parameters):
                result.append(block7_parameters[block7_index])
                block7_index = block7_index + 1
        if self.n_layers > 7:
            var block8_parameters: list[Parameter] = self.block8.parameters()
            var block8_index: int = 0
            while block8_index < len(block8_parameters):
                result.append(block8_parameters[block8_index])
                block8_index = block8_index + 1
        if self.n_layers > 8:
            var block9_parameters: list[Parameter] = self.block9.parameters()
            var block9_index: int = 0
            while block9_index < len(block9_parameters):
                result.append(block9_parameters[block9_index])
                block9_index = block9_index + 1
        if self.n_layers > 9:
            var block10_parameters: list[Parameter] = self.block10.parameters()
            var block10_index: int = 0
            while block10_index < len(block10_parameters):
                result.append(block10_parameters[block10_index])
                block10_index = block10_index + 1
        if self.n_layers > 10:
            var block11_parameters: list[Parameter] = self.block11.parameters()
            var block11_index: int = 0
            while block11_index < len(block11_parameters):
                result.append(block11_parameters[block11_index])
                block11_index = block11_index + 1
        if self.n_layers > 11:
            var block12_parameters: list[Parameter] = self.block12.parameters()
            var block12_index: int = 0
            while block12_index < len(block12_parameters):
                result.append(block12_parameters[block12_index])
                block12_index = block12_index + 1
        result.append(self.ln_f.gamma)
        result.append(self.ln_f.beta)
        return result

    def greedy_next(self, tokens: &Tensor[int64], positions: &Tensor[int64], causal_bias: &Tensor[float32]) -> int:
        var logits: Tensor[float32] = self.forward(tokens, positions, causal_bias)
        var sequence_length: int = tokens.shape(1)
        var last_slice: Tensor[float32] = logits.slice(1, sequence_length - 1, sequence_length, 1)
        var last_logits: Tensor[float32] = last_slice.reshape([1, self.vocab_size])
        return last_logits.argmax()

    def greedy_from_logits(self, logits: &Tensor[float32]) -> int:
        var last_logits: Tensor[float32] = logits.reshape([1, self.vocab_size])
        return last_logits.argmax()

    def generate_greedy(self, prompt: &Tensor[int64], max_new_tokens: int, positions: &Tensor[int64], causal_bias: &Tensor[float32]) -> Tensor[int64]:
        var prompt_length: int = prompt.shape(1)
        var total_length: int = prompt_length + max_new_tokens
        if total_length > self.max_seq_len:
            total_length = self.max_seq_len

        var output: Tensor[int64] = Tensor.zeros(1, total_length, prompt.device())
        var prompt_index: int = 0
        while prompt_index < prompt_length and prompt_index < total_length:
            output[0, prompt_index] = prompt.get(0, prompt_index)
            prompt_index = prompt_index + 1

        # eval() selects inference semantics at the Module level.  The
        # grad-enabled guard is the important memory/performance switch: no
        # autograd graph or saved forward tensors are created during decode.
        var previous_grad_enabled: bool = Tensor.grad_enabled()
        Tensor.set_grad_enabled(False)
        self.eval()

        var generated: int = total_length - prompt_length
        var step: int = 0
        while step < generated:
            var current_length: int = prompt_length + step
            var active_tokens: Tensor[int64] = output.slice(1, 0, current_length, 1)
            var active_positions: Tensor[int64] = positions.slice(1, 0, current_length, 1)
            var active_bias_rows: Tensor[float32] = causal_bias.slice(0, 0, current_length, 1)
            var active_bias: Tensor[float32] = active_bias_rows.slice(1, 0, current_length, 1)
            var next_token: int = self.greedy_next(active_tokens, active_positions, active_bias)
            output[0, current_length] = next_token
            step = step + 1

        Tensor.set_grad_enabled(previous_grad_enabled)
        return output

    def generate_greedy_kv(self, prompt: &Tensor[int64], max_new_tokens: int, positions: &Tensor[int64]) -> Tensor[int64]:
        var prompt_length: int = prompt.shape(1)
        var total_length: int = prompt_length + max_new_tokens
        if total_length > self.max_seq_len:
            total_length = self.max_seq_len
        var output: Tensor[int64] = Tensor.zeros(1, total_length, prompt.device())
        var prompt_index: int = 0
        while prompt_index < prompt_length and prompt_index < total_length:
            output[0, prompt_index] = prompt.get(0, prompt_index)
            prompt_index = prompt_index + 1

        var cache: GPT2KVCache = self.new_kv_cache(prompt.device())
        var previous_grad_enabled: bool = Tensor.grad_enabled()
        Tensor.set_grad_enabled(False)
        self.eval()
        self.freeze_for_inference()

        var prompt_positions: Tensor[int64] = positions.slice(1, 0, prompt_length, 1)
        var prompt_hidden: Tensor[float32] = self.forward_prefill_hidden(prompt, prompt_positions, cache)
        var prompt_last: Tensor[float32] = prompt_hidden.slice(1, prompt_length - 1, prompt_length, 1)
        var prompt_logits: Tensor[float32] = self.packed_logits_from_hidden(prompt_last)
        var next_token: int = self.greedy_from_logits(prompt_logits)

        var generated: int = total_length - prompt_length
        var next_input: Tensor[int64] = Tensor.zeros(1, 1, prompt.device())
        var next_position: Tensor[int64] = Tensor.zeros(1, 1, prompt.device())
        var step: int = 0
        while step < generated:
            var output_position: int = prompt_length + step
            output[0, output_position] = next_token
            if step + 1 < generated:
                next_input[0, 0] = next_token
                next_position[0, 0] = output_position
                var next_hidden: Tensor[float32] = self.forward_cached_hidden(next_input, next_position, cache, output_position)
                var next_logits: Tensor[float32] = self.packed_logits_from_hidden(next_hidden)
                next_token = self.greedy_from_logits(next_logits)
            step = step + 1

        Tensor.set_grad_enabled(previous_grad_enabled)
        return output


def fill_positions(positions: &mut Tensor[int64], sequence_length: int) -> None:
    var index: int = 0
    while index < sequence_length:
        positions[0, index] = index
        index = index + 1
    return None


def fill_causal_bias(bias: &mut Tensor[float32], sequence_length: int) -> None:
    var row: int = 0
    while row < sequence_length:
        var col: int = 0
        while col < sequence_length:
            if col > row:
                bias[row, col] = -1000000000.0
            col = col + 1
        row = row + 1
    return None


def fill_recurrence_batch(tokens: &mut Tensor[int64], targets: &mut Tensor[int64], batch_size: int, sequence_length: int, vocab_size: int) -> None:
    var row: int = 0
    while row < batch_size:
        var previous: int = (row * 3 + 1) % vocab_size
        var current: int = (row * 5 + 2) % vocab_size
        var col: int = 0
        while col < sequence_length:
            tokens[row, col] = previous
            targets[row, col] = current
            var next_token: int = (previous + current + 3) % vocab_size
            previous = current
            current = next_token
            col = col + 1
        row = row + 1
    return None
