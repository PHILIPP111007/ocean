import <std/tensor/tensor.oc>
import <std/ml/nn.oc>


def main() -> int:
    var tokens: Tensor[int64] = Tensor.zeros(2, 3, "cpu")
    var targets: Tensor[int64] = Tensor.zeros(2, 3, "cpu")

    tokens[0, 0] = 0
    tokens[0, 1] = 1
    tokens[0, 2] = 2
    tokens[1, 0] = 2
    tokens[1, 1] = 3
    tokens[1, 2] = 1

    targets[0, 0] = 1
    targets[0, 1] = 2
    targets[0, 2] = 3
    targets[1, 0] = 3
    targets[1, 1] = 1
    targets[1, 2] = 0

    var embedding: Embedding = Embedding(4, 6)
    var hidden: Tensor[float32] = embedding.forward(tokens)

    var projection: Linear = Linear(6, 4)
    var logits: Tensor[float32] = projection.forward(hidden)

    var criterion: CrossEntropyLoss = CrossEntropyLoss()
    var loss: Tensor[float32] = criterion.forward(logits, targets)
    loss.backward()

    var projection_weight: Parameter = projection.weight

    var h0: int = hidden.shape(0)
    var h1: int = hidden.shape(1)
    var h2: int = hidden.shape(2)
    print("embedding shape =", h0, h1, h2)
    print("loss =", loss.item())
    print("embedding grad =", embedding.weight_has_grad())
    print("projection grad =", projection_weight.has_grad())
    print("[ok] Ocean GPT primitives v0.1")
    return 0
