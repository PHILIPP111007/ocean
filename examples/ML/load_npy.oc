import <std/tensor/tensor.oc>


def main() -> int:
    var weights: Tensor[float32] = Tensor.load_npy("./examples/ML/MNIST/weights/fc1_bias.npy", "cpu")
    weights.save_npy("./examples/ML/MNIST/weights/fc1_bias_copy.npy")

    
    var w_len: int = len(weights)
    for i in range(w_len):
        print(weights[i], end=" ")
    print()
    return 0
