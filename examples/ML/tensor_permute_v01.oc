import <std/tensor/tensor.oc>
import <std/ml/nn.oc>


def main() -> int:
    var x: Tensor[float32] = Tensor.zeros(2, 3, 2, 2, "cpu")
    var target: Tensor[float32] = Tensor.zeros(2, 2, 3, 2, "cpu")

    x.fill(0.25)
    x.requires_grad_(True)

    var y: Tensor[float32] = x.permute([0, 2, 1, 3])

    print("y shape =", y.shape(0), y.shape(1), y.shape(2), y.shape(3))

    var criterion: MSELoss = MSELoss()
    var loss: Tensor[float32] = criterion.forward(y, target)
    loss.backward()

    print("loss =", loss.item())
    print("x has grad =", x.has_grad())
    print("[ok] Ocean Tensor.permute v0.1")
    return 0
