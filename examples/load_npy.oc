import <std/tensor/tensor.oc>


def main() -> int:
    var weights: Tensor[int64] = Tensor.load_npy("./examples/data/weights.npy", "cpu")
    weights.save_npy("./examples/data/weights_copy.npy")

    
    var w_len: int = len(weights)
    for i in range(w_len):
        print(weights[i], end=" ")
    print()
    return 0
