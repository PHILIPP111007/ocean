import <std/json/json.oc>


def main() -> int:
    var root: Json = Json.object()

    var name: Json = Json.string("Ocean")
    var version: Json = Json.integer(1)
    var enabled: Json = Json.boolean(True)
    var values: Json = Json.array()

    var first: Json = Json.integer(10)
    var second: Json = Json.integer(20)

    values.append(first)
    values.append(second)

    root.set("name", name)
    root.set("version", version)
    root.set("enabled", enabled)
    root.set("values", values)

    Json.dump(root, "ocean.json", 2)

    var loaded: Json = Json.load("ocean.json")
    var loaded_name: Json = loaded.get("name")
    var loaded_values: Json = loaded.get("values")
    var loaded_second: Json = loaded_values.at(1)

    print(loaded_name.as_str())
    print(loaded_second.as_int())
    print(loaded_values.size())

    return 0
