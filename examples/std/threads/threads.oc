import <std/multiprocessing/thread.oc>


def my_worker(arg: *void) -> None:
    unsafe:
        var typed_arg: *int = arg
        var num: int = *typed_arg
        print("Worker: arg = ", num, "\n")
    return None


def main() -> int:
    var value: int = 42

    unsafe:
        var thread: Thread = Thread.create(my_worker, &value)
        thread.join()

    print("Main: worker finished")
    return 0
